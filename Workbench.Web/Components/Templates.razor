@page "/templates"
@inject OperatorGate Gate
@inject TemplateLibraryService Library
@inject RoleRailService Roles

<h1>範本庫</h1>
@if (_denied is not null) { <p>@_denied</p> }
else
{
    <ul>
        @foreach (var item in _items)
        {
            <li><a href="@("/templates/" + item.Id + "/edit")">@item.Name</a></li>
        }
    </ul>
}

@code {
    private string? _denied;
    private List<TemplateDto> _items = [];

    protected override void OnInitialized()
    {
        var profile = Gate.Current;
        if (profile is null || (!profile.HasWork(WorkRoles.Editor) && !profile.HasWork(WorkRoles.Terminal) && !profile.IsAdmin))
        {
            _denied = "沒有權限。";
            return;
        }

        var listed = Library.List(profile.Id);
        _items = listed.Ok ? listed.Value!.ToList() : [];
    }
}
