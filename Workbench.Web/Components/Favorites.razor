@page "/favorites"
@inject OperatorGate Gate
@inject FavoriteService FavoriteList

<h1>常用清單</h1>
@if (_denied is not null) { <p>@_denied</p> }
else
{
    <ul>
        @foreach (var item in _items)
        {
            <li>
                @item.Name
                <button class="secondary" @onclick="() => Open(item.Id)">開啟</button>
            </li>
        }
    </ul>
    @if (_opened is not null)
    {
        <article>
            <h2>@_opened.Name</h2>
            @foreach (var component in _opened.Components)
            {
                <p class="block">@component.Type @component.Table @string.Join(',', component.Columns)</p>
            }
        </article>
    }
    @if (_difference is not null) { <p class="error"><span class="code">alignment_failed</span><br />@_difference</p> }
}

@code {
    private string? _denied;
    private string? _difference;
    private TemplateDto? _opened;
    private List<FavoriteDto> _items = [];

    protected override void OnInitialized()
    {
        var profile = Gate.Current;
        if (profile is null || !profile.IsTerminal)
        {
            _denied = "沒有權限。";
            return;
        }

        var listed = FavoriteList.List(profile.Id);
        _items = listed.Ok ? listed.Value!.ToList() : [];
    }

    private void Open(string id)
    {
        var profile = Gate.Current;
        if (profile is null)
            return;
        var opened = FavoriteList.Open(profile.Id, id);
        if (!opened.Ok)
        {
            _difference = opened.Error!.Message;
            return;
        }

        if (opened.Value!.ErrorCode is not null)
        {
            _opened = null;
            _difference = opened.Value.Difference;
            return;
        }

        _opened = opened.Value.Template;
        _difference = null;
    }
}
