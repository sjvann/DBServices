@inherits LayoutComponentBase
@inject CircuitSession Session
@inject OperatorGate Gate
@inject OperatorService Operators
@inject SessionService Sessions
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject PersistentComponentState Persistent

<div class="shell" tabindex="-1" @onkeydown="OnKey">
    <nav class="rail" aria-label="工作台">
        <p class="brand">報表工作台</p>
        @if (_me is null)
        {
            <p class="meta">工作階段</p>
            <NavLink href="/" Match="NavLinkMatch.All">登入</NavLink>
        }
        else
        {
            <p class="who">@_me.DisplayName</p>
            @if (_station == EntryNames.Analyst)
            {
                <p class="workplace">定義檢視</p>
                <p class="meta">系統分析師</p>
                <NavLink href="/views">檢視</NavLink>
            }
            else if (_station == EntryNames.Designer)
            {
                <p class="workplace">排樣式</p>
                <p class="meta">報表設計師</p>
                <NavLink href="/styles">樣式</NavLink>
            }
            else if (_station == EntryNames.Terminal)
            {
                <p class="workplace">產生報表</p>
                <p class="meta">終端使用者</p>
                <NavLink href="/talk">交談</NavLink>
                <NavLink href="/records">生成紀錄</NavLink>
            }
            else if (_page == "stations")
            {
                <p class="workplace">選擇工作</p>
                <p class="meta">換成另一個已指派的工作</p>
            }
            else if (_page == "environment")
            {
                <p class="workplace">環境設定</p>
                <p class="meta">資料庫連線與 AI</p>
            }
            @if (_me.IsAdmin)
            {
                <p class="meta">管理</p>
                <NavLink href="/environment">環境設定</NavLink>
                <NavLink href="/operators">帳號</NavLink>
                <NavLink href="/entries">入口指派</NavLink>
            }
            <div class="rail-foot">
                @if (_me.Entries.Count > 1)
                {
                    <NavLink href="/stations">換工作</NavLink>
                    <p class="meta">你有多個工作身份，這裡整頁換過去。</p>
                }
                <button class="secondary" type="button" @onclick="Logout">登出</button>
            </div>
        }
    </nav>
    <div class="main">
        <article class="content">
            <CascadingValue Value="this">@Body</CascadingValue>
        </article>
    </div>
</div>

@code {
    private MeResponse? _me;
    private string? _station;
    private string? _page;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            var cookie = HttpContext.Request.Cookies["wb_session"];
            if (!string.IsNullOrEmpty(cookie))
                Session.Adopt(cookie);
        }
        else if (Persistent.TryTakeFromJson<string>("wb_session", out var restored) && !string.IsNullOrEmpty(restored))
        {
            Session.Adopt(restored);
        }

        Persistent.RegisterOnPersisting(PersistSession);
        await RefreshAsync();
    }

    private Task PersistSession()
    {
        if (!string.IsNullOrEmpty(Session.SessionId))
            Persistent.PersistAsJson("wb_session", Session.SessionId);
        return Task.CompletedTask;
    }

    public async Task RefreshAsync()
    {
        var profile = Gate.Current;
        _me = profile is null ? null : OperatorService.ToMe(profile);
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _page = relative;
        _station = relative switch
        {
            "views" => EntryNames.Analyst,
            "styles" => EntryNames.Designer,
            "talk" or "records" => EntryNames.Terminal,
            _ => null,
        };
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        Sessions.Logout(Session.SessionId);
        await Js.InvokeVoidAsync("wbClearSession");
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            DialogHost.Escape();
    }
}
