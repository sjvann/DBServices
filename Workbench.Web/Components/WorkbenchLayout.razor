@inherits LayoutComponentBase
@implements IDisposable
@inject CircuitSession Session
@inject OperatorGate Gate
@inject OperatorService Operators
@inject SessionService Sessions
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject PersistentComponentState Persistent

<div class="shell" tabindex="-1" @onkeydown="OnKey">
    <nav class="rail" aria-label="工作台">
        <p class="brand">報表工作台</p>
        @if (_me is null)
        {
            <p class="meta">工作階段</p>
            <NavLink href="/" Match="NavLinkMatch.All">登入</NavLink>
        }
        else
        {
            <p class="who">@_me.DisplayName</p>
            <p class="meta">工作</p>
            @foreach (var item in WorkMenu)
            {
                if (_me.Entries.Contains(item.Entry))
                {
                    <NavLink href="@item.Href" ActiveClass="active rail-link-active">@item.Label</NavLink>
                }
                else
                {
                    <span class="rail-disabled" role="link" aria-disabled="true" title="沒有權限">@item.Label</span>
                }
            }
            @if (_me.IsAdmin)
            {
                <p class="meta">管理</p>
                <NavLink href="/environment">環境設定</NavLink>
                <NavLink href="/operators">帳號</NavLink>
                <NavLink href="/entries">入口指派</NavLink>
            }
            <div class="rail-foot">
                <button class="secondary" type="button" @onclick="Logout">登出</button>
            </div>
        }
    </nav>
    <div class="main">
        <article class="content">
            <CascadingValue Value="this">@Body</CascadingValue>
        </article>
    </div>
</div>

@code {
    private static readonly (string Entry, string Href, string Label)[] WorkMenu =
    [
        (EntryNames.Governance, "/governance", "註記"),
        (EntryNames.Analyst, "/views", "檢視"),
        (EntryNames.Designer, "/styles", "樣式"),
        (EntryNames.Terminal, "/talk", "產生報表"),
        (EntryNames.Terminal, "/records", "生成紀錄"),
    ];

    private MeResponse? _me;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            var cookie = HttpContext.Request.Cookies["wb_session"];
            if (!string.IsNullOrEmpty(cookie))
                Session.Adopt(cookie);
        }
        else if (Persistent.TryTakeFromJson<string>("wb_session", out var restored) && !string.IsNullOrEmpty(restored))
        {
            Session.Adopt(restored);
        }

        Persistent.RegisterOnPersisting(PersistSession);
        Nav.LocationChanged += OnLocationChanged;
        await RefreshAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(RefreshAsync);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private Task PersistSession()
    {
        if (!string.IsNullOrEmpty(Session.SessionId))
            Persistent.PersistAsJson("wb_session", Session.SessionId);
        return Task.CompletedTask;
    }

    public async Task RefreshAsync()
    {
        var profile = Gate.Current;
        _me = profile is null ? null : OperatorService.ToMe(profile);
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        Sessions.Logout(Session.SessionId);
        await Js.InvokeVoidAsync("wbClearSession");
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            DialogHost.Escape();
    }
}
