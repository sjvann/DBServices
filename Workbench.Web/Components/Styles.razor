@page "/styles"
@inject OperatorGate Gate
@inject StyleService StyleEditor
@inject EnvironmentService Environments
@layout WorkbenchLayout

<div class="page">
<h1>樣式</h1>
@if (_denied)
{
    <p role="alert">沒有權限。</p>
}
else if (_closed)
{
    <SetupRequired Snapshot="_snapshot" Admin="Gate.Current?.IsAdmin == true" />
}
else
{
    <p class="lead">選一份已發布的檢視，系統會排出標題、說明與表格。用上移、下移調整順序，再採用。</p>
    @if (_error is not null)
    {
        <div class="error" role="alert"><span>@_error.Message</span></div>
    }
    <form class="panel" @onsubmit="Suggest" @onsubmit:preventDefault="true">
        <label for="style-view">檢視
            <select id="style-view" @bind="_viewId" @bind:after="PrefillName">
                <option value="">選擇檢視</option>
                @foreach (var view in _views)
                {
                    <option value="@view.Id">@view.Name</option>
                }
            </select>
        </label>
        <label for="style-name">樣式名稱
            <input id="style-name" autocomplete="off" placeholder="可以沿用檢視的名字" @bind="_name" @bind:event="oninput" />
        </label>
        <label><input type="checkbox" @bind="_shared" /> 其他人也能用</label>
        <div class="actions">
            <button class="confirm" type="submit">排出版面</button>
            <button class="secondary" type="button" @onclick="Accept">採用</button>
            <button class="secondary" type="button" @onclick="Ignore">先不用</button>
        </div>
    </form>
    @if (_blocks.Count > 0)
    {
        <ol class="block-list">
            @for (var index = 0; index < _blocks.Count; index++)
            {
                var block = _blocks[index];
                var current = index;
                <li>
                    <span>@BlockLabel(block)</span>
                    <span>
                        <button type="button" @onclick="() => Move(current, -1)">上移</button>
                        <button type="button" @onclick="() => Move(current, 1)">下移</button>
                    </span>
                </li>
            }
        </ol>
    }
}
</div>

@code {
    private bool _denied;
    private bool _closed;
    private EnvironmentSnapshot _snapshot = EnvironmentSnapshot.NotReady;
    private ErrorDto? _error;
    private string _viewId = "";
    private string _name = "";
    private bool _shared;
    private string? _styleId;
    private List<StyleBlockDto> _blocks = [];
    private List<ViewSummaryDto> _views = [];

    protected override async Task OnInitializedAsync()
    {
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Designer))
        {
            _denied = true;
            return;
        }

        await Environments.RefreshAsync(CancellationToken.None);
        _snapshot = Environments.Current;
        _closed = !_snapshot.Ready;
        if (_closed)
            return;

        var listed = await StyleEditor.PublishedViewsAsync(profile.Id, CancellationToken.None);
        if (!listed.Ok)
        {
            _error = listed.Error;
            return;
        }

        _views = listed.Value!.ToList();
    }

    private void PrefillName()
    {
        if (!string.IsNullOrWhiteSpace(_name))
            return;
        var match = _views.FirstOrDefault(item => item.Id == _viewId);
        if (match is not null)
            _name = match.Name;
    }

    private static string BlockLabel(StyleBlockDto block) => block.Type switch
    {
        "title" => "標題：" + block.Text,
        "text" => "說明：" + block.Text,
        "parameter" => "要問的條件：" + (block.Label ?? block.Parameter),
        "table" => "表格：" + string.Join("、", block.Columns),
        _ => block.Text ?? block.Parameter ?? string.Join("、", block.Columns),
    };

    private async Task Suggest()
    {
        var result = await StyleEditor.SuggestAsync(Gate.Current!.Id, _viewId, CancellationToken.None);
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        _blocks = result.Value!.ToList();
    }

    private async Task Accept()
    {
        var result = await StyleEditor.AcceptAsync(Gate.Current!.Id, new StyleWriteRequest
        {
            Id = _styleId,
            Name = _name,
            ViewId = _viewId,
            Shared = _shared,
            Blocks = _blocks,
        }, CancellationToken.None);
        _error = result.Error;
        if (result.Ok)
        {
            _styleId = result.Value!.Id;
            _blocks = result.Value.Blocks;
        }
    }

    private void Ignore()
    {
        var result = StyleEditor.Ignore(Gate.Current!.Id, _styleId);
        _error = result.Error;
        if (result.Ok && result.Value is not null)
            _blocks = result.Value.Blocks;
    }

    private void Move(int index, int direction)
    {
        if (string.IsNullOrEmpty(_styleId))
        {
            var target = index + direction;
            if (index < 0 || target < 0 || index >= _blocks.Count || target >= _blocks.Count)
                return;
            (_blocks[index], _blocks[target]) = (_blocks[target], _blocks[index]);
            _blocks = StyleService.Reindex(_blocks);
            return;
        }

        var result = StyleEditor.Move(Gate.Current!.Id, _styleId, index, direction);
        _error = result.Error;
        if (result.Ok)
            _blocks = result.Value!.Blocks;
    }
}
