@page "/model"
@inject OperatorGate Gate
@inject ModelSettingsService Model

<h1>模型設定</h1>
@if (_denied is not null) { <p>@_denied</p> }
else if (_model is not null)
{
    <label><input type="checkbox" @bind="_enabled" /> 啟用</label>
    <label>位置 <input @bind="_placement" /></label>
    <label>端點 <input @bind="_endpoint" /></label>
    <label>模型 <input @bind="_modelId" /></label>
    <label>金鑰 <input type="password" @bind="_apiKey" /></label>
    <p>金鑰已設定：@(_model.ApiKeySet ? "是" : "否")</p>
    <button class="secondary" @onclick="Save">儲存</button>
    <button class="secondary" @onclick="Probe">探測</button>
    @if (_result is not null) { <p class="code">@_result.Code</p><p>@_result.Message</p> }
}

@code {
    private string? _denied;
    private ModelDto? _model;
    private bool _enabled;
    private string _placement = "local";
    private string _endpoint = "";
    private string _modelId = "";
    private string _apiKey = "";
    private ModelResultDto? _result;

    protected override void OnInitialized()
    {
        var profile = Gate.Current;
        if (profile is null || !profile.IsAdmin)
        {
            _denied = "沒有權限。";
            return;
        }

        var read = Model.Read(profile.Id);
        if (!read.Ok)
        {
            _denied = read.Error!.Message;
            return;
        }

        _model = read.Value;
        _enabled = _model!.Enabled;
        _placement = _model.Placement;
        _endpoint = _model.Endpoint;
        _modelId = _model.ModelId;
    }

    private void Save()
    {
        var profile = Gate.Current;
        if (profile is null)
            return;
        var saved = Model.Save(profile.Id, new ModelWriteRequest
        {
            Enabled = _enabled,
            Placement = _placement,
            Endpoint = _endpoint,
            ModelId = _modelId,
            ApiKey = _apiKey,
        });
        if (saved.Ok)
        {
            _model = saved.Value;
            _apiKey = "";
            _result = new ModelResultDto { Code = ModelCodes.Ok, Message = "已儲存" };
        }
        else
        {
            _result = new ModelResultDto { Code = saved.Error!.Code, Message = saved.Error.Message };
        }
    }

    private async Task Probe()
    {
        var profile = Gate.Current;
        if (profile is null)
            return;
        var probed = await Model.ProbeAsync(profile.Id, new ProbeRequest
        {
            Placement = _placement,
            Endpoint = _endpoint,
            ModelId = _modelId,
            ApiKey = _apiKey,
        }, CancellationToken.None);
        _result = probed.Ok ? probed.Value : new ModelResultDto { Code = probed.Error!.Code, Message = probed.Error.Message };
    }
}
