@page "/entries"
@inject OperatorGate Gate
@inject OperatorService Accounts
@layout WorkbenchLayout

<div class="page">
<h1>入口指派</h1>
@if (_denied)
{
    <p role="alert">沒有權限。</p>
}
else
{
    @if (_error is not null)
    {
        <div class="status-message" role="alert">
            <span>@_error.Message</span>
            <span>@_error.Code</span>
        </div>
    }
    <label>操作者
        <select @bind="_operatorId" @bind:after="LoadSelection">
            @foreach (var item in _operators)
            {
                <option value="@item.Id">@item.DisplayName</option>
            }
        </select>
    </label>
    @foreach (var entry in EntryNames.All)
    {
        var current = entry;
        <label>
            <input type="checkbox" checked="@_selected.Contains(current)" @onchange="args => Toggle(current, args)" />
            @EntryNames.Label(current)
        </label>
    }
    <div class="actions">
        <button class="confirm" type="button" @onclick="Save">保存</button>
    </div>
}
</div>

@code {
    private bool _denied;
    private ErrorDto? _error;
    private string _operatorId = "";
    private IReadOnlyList<OperatorDto> _operators = [];
    private HashSet<string> _committed = new(StringComparer.Ordinal);
    private HashSet<string> _selected = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        var profile = Gate.Current;
        if (profile is not { IsAdmin: true })
        {
            _denied = true;
            return;
        }

        var listed = Accounts.List(profile.Id);
        _operators = listed.Ok ? listed.Value! : [];
        _operatorId = _operators.FirstOrDefault()?.Id ?? "";
        LoadSelection();
    }

    private void LoadSelection()
    {
        var match = _operators.FirstOrDefault(item => item.Id == _operatorId);
        _committed = new HashSet<string>(match?.Entries ?? [], StringComparer.Ordinal);
        _selected = new HashSet<string>(_committed, StringComparer.Ordinal);
    }

    private void Toggle(string entry, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
            _selected.Add(entry);
        else
            _selected.Remove(entry);
    }

    private void Save()
    {
        var profile = Gate.Current!;
        var result = Accounts.Assign(profile.Id, _operatorId, _selected.ToList());
        if (!result.Ok)
        {
            _selected = new HashSet<string>(_committed, StringComparer.Ordinal);
            _error = result.Error;
            return;
        }

        var saved = result.Value!.Entries;
        var match = _operators.FirstOrDefault(item => item.Id == _operatorId);
        if (match is not null)
            match.Entries = saved.ToList();
        _committed = new HashSet<string>(saved, StringComparer.Ordinal);
        _selected = new HashSet<string>(_committed, StringComparer.Ordinal);
        _error = null;
    }
}
