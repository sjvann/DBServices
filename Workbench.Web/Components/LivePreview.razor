@page "/live"
@inject OperatorGate Gate
@inject LivePreviewService Preview
@inject NavigationManager Nav

<h1>活資料預覽</h1>
@if (_denied is not null)
{
    <p>@_denied</p>
}
else
{
    @if (_catalogError is not null)
    {
        <div class="error" role="alert"><span class="code">@_catalogError</span></div>
    }
    <label>連線
        <select @bind="_connection">
            @foreach (var item in _connections)
            {
                <option value="@item.Name">@item.Name · @item.ServerType</option>
            }
        </select>
    </label>
    <div class="toolbar">
        <button class="secondary" type="button" @onclick="LoadTables">載入資料表</button>
    </div>
    @if (_tables.Count == 0)
    {
        <p>沒有資料表。</p>
    }
    <label>資料表
        <select @bind="_table" @bind:after="LoadFields">
            <option value="">請選擇</option>
            @foreach (var table in _tables)
            {
                <option value="@table">@table</option>
            }
        </select>
    </label>
    <div class="field-row">
        <label>篩選鍵 <input @bind="_filterKey" @bind:event="oninput" /></label>
        <label>篩選值 <input @bind="_filterValue" @bind:event="oninput" /></label>
    </div>
    <p class="sunken">確認之前，這裡沒有業務列。</p>
    @if (_rows is not null)
    {
        <table>
            <thead><tr>@foreach (var column in _columns) { <th>@column</th> }</tr></thead>
            <tbody>
            @foreach (var row in _rows)
            {
                <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
            }
            </tbody>
        </table>
        @if (_rows.Count == 0) { <p>沒有符合的列。</p> }
    }
    @if (_count is not null) { <p class="code">@_count</p> }
    @if (_error is not null)
    {
        <div class="error" role="alert"><span class="code">@_error.Code</span><span>@_error.Message</span></div>
    }
    <div class="toolbar">
        <button class="confirm" type="button" disabled="@string.IsNullOrWhiteSpace(_table)" @onclick="Query">查詢</button>
        <button class="confirm" type="button" disabled="@string.IsNullOrWhiteSpace(_table)" @onclick="Count">計數</button>
    </div>
    @if (string.IsNullOrWhiteSpace(_table))
    {
        <p class="reason">請先選擇資料表。</p>
    }
}

@code {
    [CascadingParameter]
    private WorkbenchLayout? Layout { get; set; }

    private string _connection = "";
    private string _table = "";
    private string _filterKey = "";
    private string _filterValue = "";
    private string? _denied;
    private string? _catalogError;
    private decimal? _count;
    private ErrorDto? _error;
    private List<ConnectionDto> _connections = [];
    private List<string> _tables = [];
    private List<string> _columns = [];
    private List<List<string>>? _rows;

    protected override async Task OnInitializedAsync()
    {
        var profile = Gate.Current;
        if (profile is null || !profile.HasWork(WorkRoles.Planner))
        {
            _denied = profile is null ? "尚未登入。" : "沒有權限。";
            return;
        }

        var listed = await Preview.ConnectionsAsync(profile.Id, SurfaceNames.Mcp, CancellationToken.None);
        if (!listed.Ok)
        {
            _denied = listed.Error!.Message;
            return;
        }

        if (!listed.Value!.Ok)
        {
            _catalogError = listed.Value.ErrorCode;
            return;
        }

        _connections = listed.Value.Connections;
        if (_connections.Count > 0)
            _connection = _connections[0].Name;
    }

    private async Task LoadTables()
    {
        var profile = Gate.Current;
        if (profile is null || string.IsNullOrEmpty(_connection))
            return;
        var tables = await Preview.TablesAsync(profile.Id, SurfaceNames.Mcp, _connection, CancellationToken.None);
        if (tables.Value is { Ok: false })
        {
            _error = new ErrorDto { Code = tables.Value.ErrorCode ?? "", Message = tables.Value.ErrorMessage ?? "" };
            _tables = [];
            Layout?.ShowTraces(tables.Value.Traces);
            return;
        }

        _error = null;
        _tables = tables.Value?.Tables ?? [];
        _table = "";
    }

    private async Task LoadFields()
    {
        var profile = Gate.Current;
        if (profile is null || string.IsNullOrWhiteSpace(_table))
            return;
        var fields = await Preview.FieldsAsync(profile.Id, SurfaceNames.Mcp, _connection, _table, CancellationToken.None);
        if (fields.Value is { Ok: false })
        {
            _error = new ErrorDto { Code = fields.Value.ErrorCode ?? "", Message = fields.Value.ErrorMessage ?? "" };
            Layout?.ShowTraces(fields.Value.Traces);
        }
    }

    private async Task Query() => await Run(true);

    private async Task Count() => await Run(false);

    private async Task Run(bool query)
    {
        var profile = Gate.Current;
        if (profile is null || string.IsNullOrEmpty(Gate.SessionId) || string.IsNullOrWhiteSpace(_table))
            return;
        var request = new PlanRequest
        {
            Surface = SurfaceNames.Mcp,
            Connection = _connection,
            Table = _table,
            Filters = string.IsNullOrWhiteSpace(_filterKey) ? [] : [new FilterDto { Key = _filterKey, Value = _filterValue }],
        };
        var result = query
            ? await Preview.ConfirmQueryAsync(Gate.SessionId, profile.Id, request, CancellationToken.None)
            : await Preview.ConfirmCountAsync(Gate.SessionId, profile.Id, request, CancellationToken.None);
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        if (!string.IsNullOrEmpty(result.Value!.ErrorCode))
        {
            _error = new ErrorDto { Code = result.Value.ErrorCode!, Message = result.Value.ErrorMessage ?? "" };
            Layout?.ShowTraces(result.Value.Traces);
            return;
        }

        _error = null;
        if (query)
        {
            _columns = result.Value.Columns;
            _rows = result.Value.Rows;
            _count = null;
        }
        else
        {
            _count = result.Value.Count ?? 0;
        }

        Layout?.ShowTraces(result.Value.Traces);
        if (!string.IsNullOrEmpty(result.Value.SnapshotId))
            Nav.NavigateTo("/preview/" + result.Value.SnapshotId);
    }
}
