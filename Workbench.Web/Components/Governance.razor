@page "/governance"
@using System.Net.Http
@using System.Text
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject OperatorGate Gate
@inject IAnnotationCatalog Annotations
@inject IServiceProvider Services
@inject IJSRuntime Js
@layout WorkbenchLayout

<div class="page @(_shown is null ? "" : "wide")">
@if (_denied)
{
    <p role="alert">沒有權限。</p>
}
else
{
    <div class="station-head">
        <h1>註記</h1>
        @if (_error is not null)
        {
            <div class="status-message" role="alert" tabindex="-1" @ref="_errorRef">
                <span>@_error.Message</span>
                <span class="code">@_error.Code</span>
            </div>
        }
        @if (_result is not null)
        {
            <p class="result-line" role="status">@_result</p>
        }
        @if (_busy)
        {
            <p class="progress-line">@(_reading ? WorkbenchMessages.ReadingStructure : WorkbenchMessages.Importing)</p>
        }
        <div class="package-bar">
            @if (_shown is not null)
            {
                <div class="package-id">
                    <span class="code">@_shown.Title</span>
                    <span>@(_shown.Status == "confirmed" ? "已確認" : "草稿")</span>
                    @if (_shown.Status == "confirmed" && _shown.Active)
                    {
                        <span class="badge">設計端正在用</span>
                    }
                    @if (Unsaved)
                    {
                        <span class="badge">尚未保存</span>
                    }
                </div>
                @if (NamedPackages().Any())
                {
                    <details class="package-switch">
                        <summary>其他註記包</summary>
                        @foreach (var item in NamedPackages())
                        {
                            <button type="button" class="secondary" @key="item.Id" @onclick="() => OpenPackage(item)">@item.Title</button>
                        }
                    </details>
                }
            }
            else if (!_catalogDown)
            {
                <p class="lead">還沒有註記包。先選一筆資料庫連線並讀結構。若有 Excel 字典，可匯入當預設註解。</p>
            }
            <div class="action-group">
                <label class="import" for="annotation-import">匯入 Excel</label>
                <InputFile id="annotation-import" class="file-input" OnChange="OnImport" MaxAllowedSize="8388608" @attributes="BusyAttributes" />
                @if (_connections.Count > 0)
                {
                    <label class="stack" for="annotation-connection">連線
                        <select id="annotation-connection" @bind="_connectionId" disabled="@_busy">
                            <option value="">選擇連線</option>
                            @foreach (var item in _connections)
                            {
                                <option value="@item.Name">@item.Name</option>
                            }
                        </select>
                    </label>
                }
                <button type="button" id="annotation-read" class="secondary" @onclick="OnRead" @attributes="BusyAttributes">讀結構</button>
            </div>
            <div class="action-group">
                @if (_shown?.Status == "draft")
                {
                    <button type="button" id="annotation-save" class="@(Unsaved ? "confirm" : null)" @onclick="OnSave" disabled="@(_forking || FieldsBusy)">保存</button>
                }
                <button type="button" id="annotation-export" @onclick="OnExport" disabled="@(_shown is null)">匯出</button>
                @if (_draft is not null)
                {
                    <button type="button" id="annotation-abandon" class="secondary" @onclick="AskAbandon" disabled="@(_busy || _saving || _forking || _confirming || _abandoning)">放棄草稿</button>
                }
                <button type="button" id="annotation-confirm" class="confirm" @onclick="AskConfirm" disabled="@(!CanConfirm)">確認</button>
                @if (ConfirmHint is { } hint)
                {
                    <span class="meta" id="confirm-hint">@hint</span>
                }
            </div>
        </div>
        @if (_shown is not null)
        {
            <label>
                整包功能說明
                <textarea class="purpose-field" aria-label="整包功能說明" rows="3" disabled="@(!CanEdit || FieldsBusy)" value="@_shown.Purpose" @oninput="OnPurpose"></textarea>
            </label>
            <ul class="readiness" aria-label="確認準備">
                <li>整包功能說明：@(string.IsNullOrWhiteSpace(_shown.Purpose) ? "尚未填寫" : "已填")</li>
                <li>@_shown.Tables.Count 張表、@ColumnTotal 個欄</li>
                <li>尚未註記：@UnnotedTotal 欄</li>
                <li>關聯：@_shown.Links.Count 條</li>
                @if (_shown.Changes is { Count: > 0 })
                {
                    <li>這次差異：@_shown.Changes.Count 處</li>
                }
            </ul>
        }
    </div>
    @if (_shown is not null)
    {
        <div class="station-body">
        <ul class="schema-tree table-list">
            @foreach (var table in _shown.Tables)
            {
                var open = _selected == table.Name;
                <li class="tree-node @(open ? "open" : null)">
                    <div class="tree-row">
                        <button type="button" class="secondary index-item" aria-expanded="@(open ? "true" : "false")" aria-current="@(open ? "true" : "false")" @onclick="() => SelectTable(table.Name)">
                            <span class="code">@table.Name</span>
                        </button>
                        <p class="meta">@TableSummary(table)</p>
                    </div>
                    @if (open)
                    {
                        <div class="tree-children">
                            <label>
                                表註
                                <textarea class="table-note purpose-field" aria-label="表註" rows="3" disabled="@(!CanEdit || FieldsBusy)" value="@table.Note" @oninput="e => OnTableNote(table, e)"></textarea>
                            </label>
                            <div class="column-tools">
                                <input type="search" aria-label="搜尋欄名" value="@_query" @oninput="OnQuery" />
                                <button type="button" aria-pressed="@(_columnFilter == "all" ? "true" : "false")" @onclick='() => SetFilter("all")'>全部</button>
                                <button type="button" aria-pressed="@(_columnFilter == "blank" ? "true" : "false")" @onclick='() => SetFilter("blank")'>尚未註記</button>
                                <button type="button" aria-pressed="@(_columnFilter == "pii" ? "true" : "false")" @onclick='() => SetFilter("pii")'>有個資</button>
                                <button type="button" aria-pressed="@(_columnFilter == "changed" ? "true" : "false")" @onclick='() => SetFilter("changed")'>這次有差異</button>
                                <button type="button" id="annotation-next-blank" class="secondary" @onclick="NextUnnoted" disabled="@(UnnotedTotal == 0 || !CanEdit || FieldsBusy)">下一個尚未註記</button>
                            </div>
                            <ul class="column-list">
                                @foreach (var column in VisibleColumns(table))
                                {
                                    var blank = string.IsNullOrWhiteSpace(column.Note);
                                    var columnOpen = ColumnOpen(column.Name);
                                    <li>
                                        <article class="column-record @(columnOpen ? "open" : null) @(_markedColumn == column.Name ? "marked" : null)" data-column="@column.Name" @key="column.Name">
                                            <header>
                                                <button type="button" class="tree-toggle" aria-expanded="@(columnOpen ? "true" : "false")" @onclick="() => ToggleColumn(column.Name)">
                                                    <span class="code">@column.Name</span>
                                                    <span class="code">@column.Type</span>
                                                    @if (column.PrimaryKey)
                                                    {
                                                        <span class="badge">主鍵</span>
                                                    }
                                                    @if (column.NotNull)
                                                    {
                                                        <span class="badge">不可空白</span>
                                                    }
                                                    @if (column.UniqueIndex)
                                                    {
                                                        <span class="badge">唯一索引</span>
                                                    }
                                                    @if (blank)
                                                    {
                                                        <span class="unnoted">尚未註記</span>
                                                    }
                                                    @if (ColumnChanged(table.Name, column.Name))
                                                    {
                                                        <span class="badge">有差異</span>
                                                    }
                                                    @if (!blank)
                                                    {
                                                        <span class="note-preview">@column.Note</span>
                                                    }
                                                </button>
                                                @if (column.UniqueIndex)
                                                {
                                                    <input type="checkbox" class="check-keep" checked disabled aria-label="@($"{column.Name} 唯一索引")" />
                                                }
                                            </header>
                                            <div class="column-editor" hidden="@(!columnOpen)">
                                                <label>
                                                    欄註
                                                    <textarea class="purpose-field column-note" aria-label="@($"{column.Name} 欄註")" rows="3" disabled="@(!CanEdit || FieldsBusy)" value="@column.Note" @oninput="e => OnColumnNote(column, e)"></textarea>
                                                </label>
                                                @if (column.NoteOrigin == "excel" && !string.IsNullOrWhiteSpace(column.NoteSource))
                                                {
                                                    <p class="hint">來自 @column.NoteSource</p>
                                                }
                                                @if (CanEdit && string.IsNullOrWhiteSpace(column.Note))
                                                {
                                                    var choices = ExcelChoices(table.Name, column.Name);
                                                    @if (choices.Count > 1)
                                                    {
                                                        <div class="action-group">
                                                            @foreach (var choice in choices)
                                                            {
                                                                var picked = choice;
                                                                <button type="button" class="secondary" @onclick="() => PickExcelNote(column, picked.Note, picked.File)">@picked.File</button>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                <details open="@RevealSides(column)">
                                                    <summary>欄位對照</summary>
                                                    <p class="hint">對照 Excel 字典的畫面欄與實體欄。畫面欄是 H 側的欄名與型別；實體欄是 S 側的欄名、長度與序號。個資處理保存去識別化註記，這一輪不執行遮罩。畫面格式與資料描述寫在欄註。</p>
                                                    <label>
                                                        個資處理
                                                        <input class="purpose-field" aria-label="@($"{column.Name} 個資")" disabled="@(!CanEdit || FieldsBusy)" value="@column.Pii" @oninput="e => OnPii(column, e)" />
                                                    </label>
                                                    @if (!string.IsNullOrWhiteSpace(column.HName) || !string.IsNullOrWhiteSpace(column.HType))
                                                    {
                                                        <p class="meta">畫面欄 @column.HName @column.HType</p>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(column.SName) || !string.IsNullOrWhiteSpace(column.SLength) || !string.IsNullOrWhiteSpace(column.SOrdinal))
                                                    {
                                                        <p class="meta">實體欄 @column.SName 長度 @column.SLength 序號 @column.SOrdinal</p>
                                                    }
                                                </details>
                                            </div>
                                        </article>
                                    </li>
                                }
                            </ul>
                            @if (!VisibleColumns(table).Any())
                            {
                                <p class="meta">沒有符合的欄。</p>
                            }
                            @if (table.Indexes.Count > 0)
                            {
                                <div class="tree-node @(_indexesOpen ? "open" : null)">
                                    <button type="button" class="secondary tree-branch" aria-expanded="@(_indexesOpen ? "true" : "false")" @onclick="ToggleIndexes">索引</button>
                                    <div class="tree-children" hidden="@(!_indexesOpen)">
                                        @foreach (var index in table.Indexes)
                                        {
                                            <div data-index="@index.Name">
                                                <p class="code">@index.Name</p>
                                                <p class="code">@string.Join("、", index.Columns)</p>
                                                <label>
                                                    索引說明
                                                    <textarea class="purpose-field" aria-label="@($"{index.Name} 索引說明")" rows="2" disabled="@(!CanEdit || FieldsBusy)" value="@index.Note" @oninput="e => OnIndexNote(table, index, e)"></textarea>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
        <details class="tree-branch">
            <summary>關聯</summary>
            <ul class="link-editor">
            @foreach (var link in _shown.Links)
            {
                <li @key="@($"{link.From}.{link.FromColumn}>{link.To}.{link.ToColumn}")">
                    <p class="link-line">
                        <span class="code">@link.From</span>
                        <span class="code">@link.FromColumn</span>
                        <span aria-hidden="true">→</span>
                        <span class="code">@link.To</span>
                        <span class="code">@link.ToColumn</span>
                        <span class="badge">@OriginWord(link.Origin)</span>
                    </p>
                    <label>
                        關聯理由
                        <input class="purpose-field" aria-label="關聯理由" disabled="@(!CanEdit || FieldsBusy)" value="@link.Note" @oninput="e => OnLinkNote(link, e)" />
                    </label>
                    <button type="button" disabled="@(!CanEdit || FieldsBusy)" @onclick="() => RemoveLink(link)">刪除</button>
                </li>
            }
            <li>
                <label>
                    從
                    <select aria-label="關聯起表" disabled="@(!CanEdit || FieldsBusy)" value="@_fromTable" @onchange="OnFromTable">
                        <option value=""></option>
                        @foreach (var table in _shown.Tables)
                        {
                            <option value="@table.Name">@table.Name</option>
                        }
                    </select>
                </label>
                <select aria-label="關聯起欄" disabled="@(!CanEdit || FieldsBusy)" value="@_fromColumn" @onchange="OnFromColumn">
                    <option value=""></option>
                    @foreach (var column in ColumnsOf(_fromTable))
                    {
                        <option value="@column.Name">@column.Name</option>
                    }
                </select>
                <label>
                    到
                    <select aria-label="關聯迄表" disabled="@(!CanEdit || FieldsBusy)" value="@_toTable" @onchange="OnToTable">
                        <option value=""></option>
                        @foreach (var table in _shown.Tables)
                        {
                            <option value="@table.Name">@table.Name</option>
                        }
                    </select>
                </label>
                <select aria-label="關聯迄欄" disabled="@(!CanEdit || FieldsBusy)" value="@_toColumn" @onchange="OnToColumn">
                    <option value=""></option>
                    @foreach (var column in ColumnsOf(_toTable))
                    {
                        <option value="@column.Name">@column.Name</option>
                    }
                </select>
                <label>
                    關聯理由
                    <input class="purpose-field" aria-label="新關聯理由" disabled="@(!CanEdit || FieldsBusy)" value="@_linkNote" @oninput="OnNewLinkNote" />
                </label>
                <button type="button" disabled="@(!CanEdit || FieldsBusy)" @onclick="AddLink">新增</button>
            </li>
        </ul>
        </details>
        @if (_shown.Status == "draft" && _shown.Changes is { Count: > 0 })
        {
            <ul class="diff-list" tabindex="0" aria-label="差異">
                @foreach (var change in _shown.Changes)
                {
                    <li class="@DiffClass(change.Kind)">
                        <button type="button" @onclick="() => GoToChange(change)">
                            <span class="code">@change.Table</span>
                            @if (!string.IsNullOrEmpty(change.Column))
                            {
                                <span class="code">@change.Column</span>
                            }
                            <span>@DiffWord(change.Kind)</span>
                        </button>
                    </li>
                }
            </ul>
        }
        @if (_dbml is not null)
        {
            <h2>匯出的 DBML</h2>
            <textarea class="dbml-block" aria-label="DBML" readonly rows="12" tabindex="0" data-download="@_download">@_dbml</textarea>
        }
        </div>
    }
}
</div>
@if (_askConfirm)
{
    <div class="scrim">
        <div class="dialog" role="dialog" aria-label="確認">
            <p>@_askText</p>
            <div class="actions">
                <button type="button" class="secondary" @onclick="CancelConfirm">取消</button>
                <button type="button" class="confirm" @onclick="CommitConfirm">確認</button>
            </div>
        </div>
    </div>
}
@if (_askAbandon)
{
    <div class="scrim">
        <div class="dialog" role="dialog" aria-label="放棄草稿">
            <p>放棄這份草稿？已確認的包維持原樣。</p>
            <div class="actions">
                <button type="button" class="secondary" @onclick="CancelAbandon">取消</button>
                <button type="button" class="confirm" @onclick="CommitAbandon">確定</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
    private static readonly JsonSerializerOptions ScriptJson = new() { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    private bool _denied;
    private bool _catalogDown;
    private bool _busy;
    private bool _reading;
    private bool _saving;
    private int _revision;
    private int _operation;
    private int _saveGeneration;
    private ErrorDto? _error;
    private AnnotationPackageDto? _draft;
    private AnnotationPackageDto? _saved;
    private string? _selected;
    private string _fromTable = "";
    private string _fromColumn = "";
    private string _toTable = "";
    private string _toColumn = "";
    private string _linkNote = "";
    private List<NamedConnection> _connections = [];
    private string _connectionId = "";
    private AnnotationPackageDto? _shown;
    private AnnotationPackageDto? _active;
    private List<AnnotationPackageDto> _others = [];
    private bool _forking;
    private Task? _forkTask;
    private bool _askConfirm;
    private bool _confirming;
    private bool _askAbandon;
    private bool _abandoning;
    private int _abandonDialog;
    private int _dialog;
    private string _askText = "";
    private string? _dbml;
    private string _download = "";
    private string? _result;
    private string _query = "";
    private string _columnFilter = "all";
    private string? _markedColumn;
    private string? _openColumn;
    private bool _indexesOpen;
    private string? _announced;
    private ElementReference _errorRef;

    private bool Retained => _shown is { Status: "confirmed", Active: false } && _shown.SourceKind != "excel";

    private bool CanEdit
        => _shown is { Status: "draft" } || (_shown is { Status: "confirmed", Active: true } && _draft is null);

    private bool CanConfirm => _shown?.Status == "draft" && !_busy && !_saving && !_forking && !_confirming && !_abandoning;

    private bool FieldsBusy => _saving || _busy || _askAbandon;

    private bool Unsaved
        => _draft is not null && _saved is not null && ReferenceEquals(_shown, _draft)
            && JsonSerializer.Serialize(_draft, Json) != JsonSerializer.Serialize(_saved, Json);

    private int ColumnTotal => _shown?.Tables.Sum(table => table.Columns.Count) ?? 0;

    private int UnnotedTotal => _shown?.Tables.Sum(table => table.Columns.Count(column => string.IsNullOrWhiteSpace(column.Note))) ?? 0;

    private string? ConfirmHint
    {
        get
        {
            if (_shown is not { Status: "draft" })
                return null;
            var missingPurpose = string.IsNullOrWhiteSpace(_shown.Purpose);
            var missingShape = _shown.Tables.Count == 0 || _shown.Tables.All(table => table.Columns.Count == 0);
            if (missingPurpose && missingShape)
                return "整包功能說明還是空白，至少要有一張表、一個欄";
            if (missingPurpose)
                return "整包功能說明還是空白";
            if (missingShape)
                return "至少要有一張表、一個欄";
            return null;
        }
    }

    private IReadOnlyDictionary<string, object>? BusyAttributes
        => _busy || _saving || _forking || _abandoning || Retained ? new Dictionary<string, object> { ["disabled"] = true } : null;

    protected override async Task OnInitializedAsync()
    {
        var profile = Gate.Current;
        _denied = profile is null || !profile.Has(EntryNames.Governance);
        if (_denied || profile is null)
            return;

        await ReadStation(profile, allowStart: true);
    }

    private async Task ReadStation(Profile profile, bool allowStart)
    {
        var revision = _revision;
        try
        {
            var draft = await Annotations.DraftAsync(profile.Id, CancellationToken.None);
            var station = await Annotations.ActiveAsync(profile.Id, CancellationToken.None);
            if (Services.GetService(typeof(IConnectionAdmin)) is IConnectionAdmin admin)
            {
                _connections = (await admin.ListAsync(CancellationToken.None)).ToList();
                if (_connections.Count == 1)
                    _connectionId = _connections[0].Name;
            }
            if (revision != _revision)
                return;
            _catalogDown = false;
            _error = null;
            _active = station.Package;
            _others = station.Others ?? [];
            Remember(draft);
            if (_shown is null && _active is not null)
                _shown = Clone(_active);
            FocusTable(_shown?.Tables.FirstOrDefault()?.Name);
        }
        catch (HttpRequestException)
        {
            if (revision != _revision)
                return;
            if (allowStart && await TryStartDataService(profile))
            {
                await ReadStation(profile, allowStart: false);
                return;
            }

            _catalogDown = true;
            _error = WorkbenchMessages.Text(WorkbenchMessages.ServiceUnavailableCode, "資料服務還沒有啟動。");
        }
        catch (Exception exception) when (exception is InvalidOperationException or TaskCanceledException)
        {
            if (revision != _revision)
                return;
            _catalogDown = true;
            _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
        }
    }

    private async Task<bool> TryStartDataService(Profile profile)
    {
        if (!profile.IsAdmin)
            return false;
        if (Services.GetService(typeof(IDataServiceHost)) is not IDataServiceHost host)
            return false;
        try
        {
            var started = await host.StartAsync(CancellationToken.None);
            return started.Ok;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException or TaskCanceledException)
        {
            return false;
        }
    }

    private async Task OnImport(InputFileChangeEventArgs change)
    {
        if (_saving || _forking || _abandoning || Retained)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            return;
        }

        var revision = ++_revision;
        var operation = ++_operation;
        _busy = true;
        _reading = false;
        _error = null;
        try
        {
            await using var stream = change.File.OpenReadStream(8_388_608);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            if (revision != _revision)
                return;
            var parsed = DictionaryWorkbook.Read(change.File.Name, memory.ToArray());
            if (!parsed.Ok)
            {
                _error = parsed.Error;
                return;
            }

            var written = await Annotations.ImportAsync(parsed.Value!, profile.Id, CancellationToken.None);
            if (revision != _revision)
                return;
            if (!written.Ok)
            {
                _error = WorkbenchMessages.Text(written.Code, written.Message);
                return;
            }

            Remember(written.Package);
            FocusTable(_draft?.Tables.FirstOrDefault()?.Name);
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException)
        {
            if (revision == _revision)
                _error = WorkbenchMessages.Text("import_rejected", WorkbenchMessages.ImportRejected);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            if (revision == _revision)
                _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
        }
        finally
        {
            if (operation == _operation)
            {
                _busy = false;
                _reading = false;
            }
        }
    }

    private async Task OnRead()
    {
        if (_saving || _forking || _abandoning || Retained)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            return;
        }

        var revision = ++_revision;
        var operation = ++_operation;
        _busy = true;
        _reading = true;
        _error = null;
        try
        {
            var written = await Annotations.ReadStructureAsync(profile.Id, string.IsNullOrWhiteSpace(_connectionId) ? null : _connectionId, CancellationToken.None);
            if (!written.Ok)
            {
                if (revision == _revision)
                    _error = WorkbenchMessages.Text(written.Code, written.Message);
                return;
            }

            Remember(written.Package);
            FocusTable(_shown?.Tables.FirstOrDefault()?.Name);
            _dbml = null;
            _download = "";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            if (revision == _revision)
                _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
        }
        finally
        {
            if (operation == _operation)
            {
                _busy = false;
                _reading = false;
            }
        }
    }

    private async Task OnSave()
    {
        if (_forking || FieldsBusy)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            return;
        }

        if (_draft is null)
            return;

        var revision = ++_revision;
        var save = ++_saveGeneration;
        _saving = true;
        _error = null;
        try
        {
            var written = await Annotations.SaveAsync(Clone(_draft), profile.Id, CancellationToken.None);
            if (revision != _revision)
                return;
            if (!written.Ok)
            {
                _error = WorkbenchMessages.Text(written.Code, written.Message);
                if (_saved is not null)
                    RestoreDraft();
                return;
            }

            Remember(written.Package);
            if (_shown?.Tables.Any(table => table.Name == _selected) != true)
                _selected = _shown?.Tables.FirstOrDefault()?.Name;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            if (revision != _revision)
                return;
            _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
            if (_saved is not null)
                RestoreDraft();
        }
        finally
        {
            if (save == _saveGeneration)
                _saving = false;
        }
    }

