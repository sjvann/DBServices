    private AnnotationPackageDto? PriorPackage(AnnotationPackageDto? draft)
    {
        if (draft is null)
            return null;
        if (draft.SourceKind is not ("excel" or "connection"))
            return _active;
        return ConfirmedPackages().FirstOrDefault(package =>
            package.Id != draft.Id
            && package.SourceKind == draft.SourceKind
            && string.Equals(package.SourceKey, draft.SourceKey, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<AnnotationPackageDto> ConfirmedPackages()
    {
        if (_active is { Status: "confirmed" })
            yield return _active;
        foreach (var package in _others)
        {
            if (package.Status == "confirmed")
                yield return package;
        }
    }

    private List<(string File, string Note)> ExcelChoices(string? tableName, string? columnName)
    {
        var hits = new List<(string File, string Note)>();
        foreach (var package in ConfirmedPackages())
        {
            if (package.SourceKind != "excel")
                continue;
            var table = package.Tables.FirstOrDefault(item => item.Name == tableName);
            var column = table?.Columns.FirstOrDefault(item => item.Name == columnName);
            if (column is null || string.IsNullOrWhiteSpace(column.Note))
                continue;
            hits.Add((package.SourceKey, column.Note.Trim()));
        }

        return hits;
    }

    private async Task PickExcelNote(AnnotationColumnDto column, string note, string file)
    {
        if (EditingDraft())
        {
            column.Note = note;
            column.NoteOrigin = "excel";
            column.NoteSource = file;
            return;
        }

        var owner = _shown?.Tables.FirstOrDefault(table => table.Columns.Contains(column));
        await Fork(copy =>
        {
            var noted = copy.Tables.FirstOrDefault(table => table.Name == owner?.Name)?.Columns.FirstOrDefault(item => item.Name == column.Name);
            if (noted is null)
                return;
            noted.Note = note;
            noted.NoteOrigin = "excel";
            noted.NoteSource = file;
        });
    }

