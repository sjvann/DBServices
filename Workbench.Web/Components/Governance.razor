    {
        _askAbandon = false;
        _abandonDialog = 0;
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is InvalidOperationException or ObjectDisposedException)
        {
        }
    }

    private void CancelAbandon()
    {
        _askAbandon = false;
        var id = _abandonDialog;
        _abandonDialog = 0;
        DialogHost.Stack.Dismiss(id);
    }

    private async Task CommitAbandon()
    {
        if (_abandoning || !_askAbandon)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            CancelAbandon();
            return;
        }

        _revision++;
        _abandoning = true;
        CancelAbandon();
        try
        {
            var written = await Annotations.AbandonAsync(profile.Id, CancellationToken.None);
            if (!written.Ok)
            {
                _error = WorkbenchMessages.Text(written.Code, written.Message);
                return;
            }

            _error = null;
            _result = null;
            _draft = null;
            _saved = null;
            _dbml = null;
            _download = "";
            _fromTable = "";
            _fromColumn = "";
            _toTable = "";
            _toColumn = "";
            _linkNote = "";
            if (_active is not null)
            {
                _shown = Clone(_active);
                FocusTable(_shown.Tables.FirstOrDefault()?.Name);
            }
            else
            {
                _shown = null;
                FocusTable(null);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
        }
        finally
        {
            _abandoning = false;
        }
    }

