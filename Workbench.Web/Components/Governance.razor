            return;
        }

        await Fork(copy => copy.Links.RemoveAll(item => SameEnds(item, link.From, link.FromColumn, link.To, link.ToColumn)));
    }

    private bool Touch()
    {
        if (_saving || _forking || _busy || _askAbandon)
            return false;
        _revision++;
        return true;
    }

    private static bool SameEnds(AnnotationLinkDto link, string from, string fromColumn, string to, string toColumn)
    {
        var straight = string.Equals(link.From, from, StringComparison.Ordinal)
            && string.Equals(link.FromColumn, fromColumn, StringComparison.Ordinal)
            && string.Equals(link.To, to, StringComparison.Ordinal)
            && string.Equals(link.ToColumn, toColumn, StringComparison.Ordinal);
        var swapped = string.Equals(link.From, to, StringComparison.Ordinal)
            && string.Equals(link.FromColumn, toColumn, StringComparison.Ordinal)
            && string.Equals(link.To, from, StringComparison.Ordinal)
            && string.Equals(link.ToColumn, fromColumn, StringComparison.Ordinal);
        return straight || swapped;
    }

    private bool EditingDraft()
    {
        if (_shown?.Status != "draft" || FieldsBusy || _forking)
            return false;
        return Touch();
    }

    private async Task<bool> Fork(Action<AnnotationPackageDto> apply)
    {
        if (_saving || _shown is null)
            return false;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            return false;
        }

        if (_forking)
        {
            apply(_shown);
            if (_forkTask is not null)
                await _forkTask;
            return _shown?.Status == "draft" && _error is null;
        }

        if (_shown is not { Status: "confirmed", Active: true } || _draft is not null)
            return false;

        var kept = Clone(_shown);
        apply(_shown);
        var revision = ++_revision;
        _forking = true;
        _error = null;
        var task = FinishFork(profile.Id, kept, revision);
        _forkTask = task;
        try
        {
            return await task;
        }
        finally
        {
            if (ReferenceEquals(_forkTask, task))
            {
                _forkTask = null;
                _forking = false;
            }
        }
    }

    private async Task<bool> FinishFork(string callerId, AnnotationPackageDto kept, int revision)
    {
        AnnotationPackageDto? saved = null;
        try
        {
            while (true)
            {
                if (_shown is null)
                {
                    _shown = kept;
                    return false;
                }

                var sending = saved is null ? Clone(_shown) : Clone(saved);
                if (saved is not null)
                    CopyAnnotations(_shown, sending);
                var written = await Annotations.SaveAsync(Clone(sending), callerId, CancellationToken.None);
                if (revision != _revision)
                {
                    _shown = kept;
                    return false;
                }

                if (!written.Ok || written.Package is null)
                {
                    _error = WorkbenchMessages.Text(written.Code, written.Message);
                    _shown = kept;
                    return false;
                }

                saved = written.Package;
                if (!SameAnnotations(_shown, sending))
                    continue;

                Remember(written.Package);
                if (_shown?.Tables.Any(table => table.Name == _selected) != true)
                    _selected = _shown?.Tables.FirstOrDefault()?.Name;
                return true;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            _shown = kept;
            if (revision == _revision)
                _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
            return false;
        }
    }

    private static void CopyAnnotations(AnnotationPackageDto from, AnnotationPackageDto to)
    {
        to.Purpose = from.Purpose ?? "";
        foreach (var table in to.Tables)
        {
            var match = from.Tables.FirstOrDefault(item => item.Name == table.Name);
            if (match is null)
                continue;
            table.Note = match.Note ?? "";
            foreach (var column in table.Columns)
            {
                var noted = match.Columns.FirstOrDefault(item => item.Name == column.Name);
                if (noted is null)
                    continue;
                column.Note = noted.Note ?? "";
                column.Pii = noted.Pii ?? "";
            }

            foreach (var index in table.Indexes)
            {
                var noted = match.Indexes.FirstOrDefault(item => item.Name == index.Name);
                if (noted is not null)
                    index.Note = noted.Note ?? "";
            }
        }

        to.Links = from.Links.Select(link => new AnnotationLinkDto
        {
            From = link.From,
            FromColumn = link.FromColumn,
            To = link.To,
            ToColumn = link.ToColumn,
            Origin = link.Origin,
            Note = link.Note ?? "",
        }).ToList();
    }

    private static bool SameAnnotations(AnnotationPackageDto left, AnnotationPackageDto right)
    {
        if (!string.Equals(left.Purpose ?? "", right.Purpose ?? "", StringComparison.Ordinal))
            return false;
        if (left.Tables.Count != right.Tables.Count)
            return false;
        for (var index = 0; index < left.Tables.Count; index++)
        {
            var from = left.Tables[index];
            var to = right.Tables[index];
            if (!string.Equals(from.Name, to.Name, StringComparison.Ordinal)
                || !string.Equals(from.Note ?? "", to.Note ?? "", StringComparison.Ordinal)
                || from.Columns.Count != to.Columns.Count)
                return false;
            for (var column = 0; column < from.Columns.Count; column++)
            {
                if (!string.Equals(from.Columns[column].Name, to.Columns[column].Name, StringComparison.Ordinal)
                    || !string.Equals(from.Columns[column].Note ?? "", to.Columns[column].Note ?? "", StringComparison.Ordinal)
                    || !string.Equals(from.Columns[column].Pii ?? "", to.Columns[column].Pii ?? "", StringComparison.Ordinal))
                    return false;
            }

            if (from.Indexes.Count != to.Indexes.Count)
                return false;
            for (var slot = 0; slot < from.Indexes.Count; slot++)
            {
                if (!string.Equals(from.Indexes[slot].Name, to.Indexes[slot].Name, StringComparison.Ordinal)
                    || !string.Equals(from.Indexes[slot].Note ?? "", to.Indexes[slot].Note ?? "", StringComparison.Ordinal))
                    return false;
            }
        }

        if (left.Links.Count != right.Links.Count)
            return false;
        for (var index = 0; index < left.Links.Count; index++)
        {
            var from = left.Links[index];
            var to = right.Links[index];
            if (!string.Equals(from.From, to.From, StringComparison.Ordinal)
                || !string.Equals(from.FromColumn, to.FromColumn, StringComparison.Ordinal)
                || !string.Equals(from.To, to.To, StringComparison.Ordinal)
                || !string.Equals(from.ToColumn, to.ToColumn, StringComparison.Ordinal)
                || !string.Equals(from.Origin ?? "", to.Origin ?? "", StringComparison.Ordinal)
                || !string.Equals(from.Note ?? "", to.Note ?? "", StringComparison.Ordinal))
                return false;
        }

        return true;
    }

    private async Task OnExport()
    {
        if (_shown is null)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            return;
        }

        string text;
        if (_shown.Status == "draft")
        {
            try
            {
                var loaded = await Annotations.DraftDbmlAsync(profile.Id, CancellationToken.None);
                if (loaded is null)
                {
                    _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
                    return;
                }

                text = loaded;
            }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
            {
                _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
                return;
            }
        }
        else
            text = _shown.Dbml ?? "";

        _dbml = text;
        _download = DownloadName(_shown.Title);
        _error = null;
        try
        {
            var href = "data:application/octet-stream;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(text));
            var script = "(() => { const a = document.createElement('a'); a.href = " + JsonSerializer.Serialize(href, ScriptJson) + "; a.download = " + JsonSerializer.Serialize(_download, ScriptJson) + "; a.click(); })()";
            await Js.InvokeVoidAsync("eval", script);
        }
        catch (Exception)
        {
        }
    }

    private void AskAbandon()
    {
        if (_draft is null || _askAbandon || _busy || _saving || _forking || _confirming || _abandoning)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
