    private void SelectTable(string name)
    {
        if (_selected == name)
        {
            _selected = null;
            _openColumn = null;
            _indexesOpen = false;
            return;
        }

        _selected = name;
        _markedColumn = null;
        _openColumn = null;
        _indexesOpen = false;
    }

    private void ToggleColumn(string name) => _openColumn = _openColumn == name ? null : name;

    private void ToggleIndexes() => _indexesOpen = !_indexesOpen;

    private bool ColumnOpen(string name) => _openColumn == name;

    private void SetFilter(string filter) => _columnFilter = filter;

    private void OnQuery(ChangeEventArgs change) => _query = change.Value?.ToString() ?? "";

    private void NextUnnoted()
    {
        if (_shown is null || !CanEdit || FieldsBusy)
            return;
        var names = _shown.Tables
            .Where(table => table.Columns.Any(column => string.IsNullOrWhiteSpace(column.Note)))
            .Select(table => table.Name)
            .ToList();
        if (names.Count == 0)
            return;
        var index = names.FindIndex(name => name == _selected);
        var next = names.Count == 1 || index < 0 ? names[0] : names[(index + 1) % names.Count];
        _selected = next;
        _columnFilter = "blank";
        _query = "";
        _indexesOpen = false;
        _markedColumn = _shown.Tables.First(table => table.Name == next).Columns.First(column => string.IsNullOrWhiteSpace(column.Note)).Name;
        _openColumn = _markedColumn;
    }

    private void GoToChange(AnnotationChangeDto change)
    {
        if (_shown?.Tables.Any(table => table.Name == change.Table) != true)
            return;
        _selected = change.Table;
        _columnFilter = "all";
        _query = "";
        _indexesOpen = false;
        _markedColumn = string.IsNullOrEmpty(change.Column) ? null : change.Column;
        _openColumn = _markedColumn;
    }

    private IEnumerable<AnnotationColumnDto> VisibleColumns(AnnotationTableDto table)
    {
        IEnumerable<AnnotationColumnDto> columns = table.Columns;
        if (!string.IsNullOrWhiteSpace(_query))
            columns = columns.Where(column => column.Name.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase));
        return _columnFilter switch
        {
            "blank" => columns.Where(column => string.IsNullOrWhiteSpace(column.Note)),
            "pii" => columns.Where(column => !string.IsNullOrWhiteSpace(column.Pii)),
            "changed" => columns.Where(column => ColumnChanged(table.Name, column.Name)),
            _ => columns,
        };
    }

    private bool ColumnChanged(string table, string column)
        => _shown?.Changes.Any(change => change.Table == table && change.Column == column) == true;

    private string TableSummary(AnnotationTableDto table)
    {
        var blanks = table.Columns.Count(column => string.IsNullOrWhiteSpace(column.Note));
        var diffs = _shown?.Changes.Count(change => change.Table == table.Name) ?? 0;
        var text = table.Columns.Count + " 欄";
        if (blanks > 0)
            text += " · " + blanks + " 尚未註記";
        if (diffs > 0)
            text += " · " + diffs + " 處差異";
        return text;
    }

    private static bool RevealSides(AnnotationColumnDto column)
        => !string.IsNullOrWhiteSpace(column.Pii)
            || (!string.IsNullOrWhiteSpace(column.HName) && !string.Equals(column.HName, column.Name, StringComparison.Ordinal))
            || (!string.IsNullOrWhiteSpace(column.SName) && !string.Equals(column.SName, column.Name, StringComparison.Ordinal));

    private static string OriginWord(string? origin)
        => string.Equals(origin, "foreign-key", StringComparison.Ordinal) ? "外鍵" : "人為聲明";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_error is null)
        {
            _announced = null;
            return;
        }

        var token = _error.Code + "\n" + _error.Message;
        if (token == _announced)
            return;
        _announced = token;
        try
        {
            await _errorRef.FocusAsync();
        }
        catch (Exception)
        {
        }
    }

    public void Dispose()
    {
        if (_dialog != 0)
            DialogHost.Stack.Dismiss(_dialog);
        if (_abandonDialog != 0)
            DialogHost.Stack.Dismiss(_abandonDialog);
    }
}
