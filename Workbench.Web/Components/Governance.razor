    private async Task CommitConfirm()
    {
        if (_confirming || !_askConfirm)
            return;
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Governance))
        {
            _error = WorkbenchMessages.Forbidden();
            CancelConfirm();
            return;
        }

        var replaced = PriorPackage(_shown)?.Title;
        _confirming = true;
        CancelConfirm();
        try
        {
            var written = await Annotations.ConfirmAsync(profile.Id, _shown?.Id, CancellationToken.None);
            if (!written.Ok)
            {
                _error = WorkbenchMessages.Text(written.Code, written.Message);
                if (_shown?.Status != "confirmed")
                    _result = null;
                return;
            }

            _error = null;
            _result = "已確認。設計目錄改看這一包。" + (string.IsNullOrEmpty(replaced) ? "" : "取代了" + replaced + "。");
            try
            {
                var station = await Annotations.ActiveAsync(profile.Id, CancellationToken.None);
                _active = station.Package ?? written.Package;
                _others = station.Others ?? [];
            }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
            {
                _active = written.Package;
            }

            _draft = null;
            _saved = null;
            _shown = _active is null ? written.Package : Clone(_active);
            FocusTable(_shown?.Tables.FirstOrDefault()?.Name);
            _dbml = _shown?.Dbml;
            _download = _shown is null ? "" : DownloadName(_shown.Title);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            _error = WorkbenchMessages.Text("execution_failed", "沒有保存。");
            if (_shown?.Status != "confirmed")
                _result = null;
        }
        finally
        {
            _confirming = false;
        }
    }

