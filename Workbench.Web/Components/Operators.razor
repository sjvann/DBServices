@page "/operators"
@inject OperatorGate Gate
@inject OperatorService Accounts
@layout WorkbenchLayout

<div class="page">
<h1>帳號</h1>
@if (_denied)
{
    <p role="alert">沒有權限。</p>
}
else
{
    <p class="lead">建立可以登入的人。新帳號不是管理者，工作身份再到入口指派勾選。</p>
    @if (_error is not null)
    {
        <div class="error" role="alert"><span>@_error.Message</span></div>
    }
    <form class="panel" @onsubmit="Create" @onsubmit:preventDefault="true">
        <label>名稱<input @bind="_name" @bind:event="oninput" /></label>
        <label>密碼<input type="password" autocomplete="new-password" @bind="_secret" @bind:event="oninput" /></label>
        <button class="confirm" type="submit">建立帳號</button>
    </form>
    <ul>
        @foreach (var item in _operators)
        {
            <li>@item.DisplayName <span class="meta">@(item.IsAdmin ? "管理者" : "操作者")</span></li>
        }
    </ul>
}
</div>

@code {
    private bool _denied;
    private ErrorDto? _error;
    private string _name = "";
    private string _secret = "";
    private IReadOnlyList<OperatorDto> _operators = [];

    protected override void OnInitialized()
    {
        var profile = Gate.Current;
        if (profile is not { IsAdmin: true })
        {
            _denied = true;
            return;
        }

        Reload(profile.Id);
    }

    private void Create()
    {
        var profile = Gate.Current!;
        var result = Accounts.Create(profile.Id, new OperatorWriteRequest { DisplayName = _name, Secret = _secret, IsAdmin = false });
        _error = result.Error;
        if (result.Ok)
        {
            _name = "";
            _secret = "";
            Reload(profile.Id);
        }
    }

    private void Reload(string operatorId)
    {
        var listed = Accounts.List(operatorId);
        _operators = listed.Ok ? listed.Value! : [];
    }
}
