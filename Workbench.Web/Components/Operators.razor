@page "/operators"
@inject OperatorGate Gate
@inject AccountService Accounts

<h1>帳號</h1>
@if (_denied is not null) { <p>@_denied</p> }
else
{
    <ul>@foreach (var item in _items) { <li>@item.DisplayName</li> }</ul>
    <form class="panel" @onsubmit="Create" @onsubmit:preventDefault="true">
        <h2>建立操作者</h2>
        <label for="new-operator-name">名稱
            <input id="new-operator-name" autocomplete="off" @bind="_name" @bind:event="oninput" />
        </label>
        <label for="new-operator-secret">秘密
            <input id="new-operator-secret" type="password" autocomplete="new-password" @bind="_secret" @bind:event="oninput" />
        </label>
        <div class="actions">
            <button class="secondary" type="submit">建立</button>
        </div>
        @if (_error is not null) { <div class="error" role="alert"><span>@_error.Message</span></div> }
    </form>
}

@code {
    private string? _denied;
    private string _name = "";
    private string _secret = "";
    private ErrorDto? _error;
    private List<OperatorDto> _items = [];

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        var profile = Gate.Current;
        if (profile is null || !profile.IsAdmin)
        {
            _denied = "沒有權限。";
            return;
        }

        var listed = Accounts.List(profile.Id);
        _items = listed.Ok ? listed.Value!.ToList() : [];
    }

    private void Create()
    {
        var profile = Gate.Current;
        if (profile is null)
            return;
        var created = Accounts.Create(profile.Id, _name, _secret);
        _error = created.Ok ? null : created.Error;
        if (created.Ok)
            Reload();
    }
}
