@page "/records"
@inject OperatorGate Gate
@inject RecordService RecordEditor
@inject ExportService Export
@inject EnvironmentService Environments
@inject CircuitSession Session
@inject IJSRuntime Js
@layout WorkbenchLayout

<div class="page">
<h1>生成紀錄</h1>
@if (_denied)
{
    <p role="alert">沒有權限。</p>
}
else if (_closed)
{
    <SetupRequired Snapshot="_snapshot" Admin="Gate.Current?.IsAdmin == true" />
}
else
{
    @if (!string.IsNullOrEmpty(_notice))
    {
        <p role="status">@_notice</p>
    }
    <ul>
        @foreach (var record in _records)
        {
            <li>
                <span>@Title(record) <span class="meta">@(record.Shared ? "共享" : "只給自己")</span></span>
                <span>
                    <button type="button" @onclick="() => Open(record.Id)">打開</button>
                    @if (record.OwnerId == _operatorId)
                    {
                        <button type="button" @onclick="() => Delete(record.Id)">刪除</button>
                    }
                </span>
            </li>
        }
    </ul>
    @if (_open is not null)
    {
        <p class="meta">參數：@string.Join("、", _open.Parameters.Select(pair => pair.Key + "=" + pair.Value))</p>
        <table>
            <thead><tr>@foreach (var column in _open.Columns) { <th>@column</th> }</tr></thead>
            <tbody>
                @foreach (var row in _open.Rows)
                {
                    <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                }
            </tbody>
        </table>
        <button class="confirm" type="button" @onclick="ExportOpen">匯出這份紀錄</button>
    }
}
</div>

@code {
    private bool _denied;
    private bool _closed;
    private EnvironmentSnapshot _snapshot = EnvironmentSnapshot.NotReady;
    private string _operatorId = "";
    private string _notice = "";
    private IReadOnlyList<RecordDto> _records = [];
    private RecordDto? _open;

    protected override async Task OnInitializedAsync()
    {
        var profile = Gate.Current;
        if (profile is null || !profile.Has(EntryNames.Terminal))
        {
            _denied = true;
            return;
        }

        await Environments.RefreshAsync(CancellationToken.None);
        _snapshot = Environments.Current;
        _closed = !_snapshot.Ready;
        if (_closed)
            return;

        _operatorId = profile.Id;
        Reload();
    }

    private static string Title(RecordDto record)
    {
        var title = record.Blocks.FirstOrDefault(item => item.Type == "title")?.Text;
        if (!string.IsNullOrWhiteSpace(title))
            return title;
        return record.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private void Reload()
    {
        var listed = RecordEditor.List(_operatorId);
        _records = listed.Ok ? listed.Value! : [];
        if (!listed.Ok)
            _notice = listed.Error!.Message;
    }

    private void Open(string id)
    {
        var result = RecordEditor.Open(_operatorId, id);
        _open = result.Ok ? result.Value : null;
        _notice = result.Ok ? "" : result.Error!.Message;
    }

    private void Delete(string id)
    {
        var result = RecordEditor.Delete(_operatorId, id);
        _notice = result.Ok ? "已刪除。" : result.Error!.Message;
        if (result.Ok && _open?.Id == id)
            _open = null;
        Reload();
    }

    private async Task ExportOpen()
    {
        if (_open is null)
            return;
        var result = Export.Pdf(_operatorId, Session.SessionId ?? "", _open.Id);
        if (!result.Ok)
        {
            _notice = result.Error!.Message;
            return;
        }

        var base64 = Convert.ToBase64String(result.Value!);
        await Js.InvokeVoidAsync("eval", "(() => { const a = document.createElement('a'); a.href = 'data:application/pdf;base64," + base64 + "'; a.download = 'record.pdf'; a.click(); })()");
    }
}
