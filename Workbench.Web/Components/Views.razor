    protected override async Task OnInitializedAsync()
    {
        if (Gate.Current is not { } profile || !profile.Has(EntryNames.Analyst))
        {
            _denied = true;
            return;
        }

        await Environments.RefreshAsync(CancellationToken.None);
        _snapshot = Environments.Current;
        _closed = !_snapshot.Ready;
        if (_closed)
            return;

        await Reload(profile.Id);
        await LoadSchema();
    }

    private async Task LoadSchema()
    {
        _previewGeneration++;
        CancelPreview();
        _schemaBusy = true;
        _schemaError = null;
        try
        {
            var result = await Annotations.DesignCatalogAsync(Gate.Current!.Id, CancellationToken.None);
            if (!result.Ok)
            {
                _schemaError = result.Error;
                _tables = [];
                _declared = [];
                _eligible = [];
                _tableNotes.Clear();
                _columnNotes.Clear();
                return;
            }

            Project(result.Value);
            Align();
        }
        finally
        {
            _schemaBusy = false;
        }
    }

