@page "/views"
@implements IDisposable
@inject OperatorGate Gate
@inject ViewService ViewEditor
@inject SchemaService Schema
@inject AnnotationService Annotations
@inject EnvironmentService Environments
@inject IViewProposer Proposer
@layout WorkbenchLayout

@if (_denied)
{
    <div class="page">
        <h1>檢視</h1>
        <p role="alert">沒有權限。</p>
    </div>
}
else if (_closed)
{
    <SetupRequired Snapshot="_snapshot" Admin="Gate.Current?.IsAdmin == true" />
}
else
{
    <div class="studio">
        <aside class="library" aria-label="資料表">
            <div class="index-head">
                <h2>資料表</h2>
                <button class="secondary" type="button" disabled="@_schemaBusy" @onclick="LoadSchema">重新讀取</button>
            </div>
            <label class="stack" for="table-finder">搜尋
                <input id="table-finder" autocomplete="off" placeholder="輸入表名的一部分" @bind="_query" @bind:event="oninput" />
            </label>
            @if (_schemaBusy)
            {
                <p class="empty">正在讀取資料表。</p>
            }
            else if (_schemaError is not null)
            {
                <div class="status-message" role="alert">
                    <span>@_schemaError.Message</span>
                    <span class="code">@_schemaError.Code</span>
                </div>
            }
            else if (_tables.Count == 0)
            {
                <p class="empty-catalog">資料來源尚未註記</p>
            }
            else
            {
                @if (VisibleTables.Count == 0)
                {
                    <p class="empty">沒有符合的資料表。</p>
                }
                else
                {
                    <ul class="table-list">
                        @foreach (var table in VisibleTables)
                        {
                            var current = table;
                            var tableNote = TableNote(current.Name);
                            <li>
                                <button type="button"
                                        class="table-pick"
                                        draggable="true"
                                        aria-expanded="@ColumnOpen(current.Name)"
                                        aria-pressed="@Placed(current.Name)"
                                        @ondragstart="() => BeginDrag(current.Name)"
                                        @ondragend="EndDrag"
                                        @onclick="() => Place(current.Name)">
                                    <span>@current.Name</span>
                                    <span class="meta">@TableState(current.Name)</span>
                                </button>
                                <button class="secondary" type="button" @onclick="() => ToggleTree(current.Name)">@(ColumnOpen(current.Name) ? "收合欄位" : "展開欄位")</button>
                                @if (!string.IsNullOrWhiteSpace(tableNote))
                                {
                                    <p class="meta">@tableNote</p>
                                }
                                @if (ColumnOpen(current.Name))
                                {
                                <ul class="field-list">
                                    @foreach (var column in current.Columns)
                                    {
                                        <li>
                                            <span>@column.Name</span>
                                            <span class="meta">@column.Type</span>
                                            @if (ColumnUnmarked(current.Name, column.Name))
                                            {
                                                <span class="unmarked-badge">尚未註記</span>
                                            }
                                            else
                                            {
                                                <span>@ColumnNote(current.Name, column.Name)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (_declared.Count > 0)
                {
                    <ul class="link-list" aria-label="已聲明關聯">
                        @foreach (var link in _declared)
                        {
                            <li><span class="code">@link.From.@link.FromColumn → @link.To.@link.ToColumn</span></li>
                        }
                    </ul>
                }
            }
        </aside>
        <section class="board" aria-labelledby="view-editor-title">
            @if (_error?.Code == "link_undeclared")
            {
                <div class="status-message" role="alert">
                    <span>@_error.Message</span>
                    <span class="code">@_error.Code</span>
                </div>
            }
            else if (_error is not null)
            {
                <div class="error" role="alert">
                    @if (!string.IsNullOrEmpty(_error.Code))
                    {
                        <span class="code">@_error.Code</span>
                    }
                    <span>@_error.Message</span>
                </div>
            }
            else if (_local is not null)
            {
                <div class="error" role="alert"><span>@_local</span></div>
            }
            <div class="board-bar">
                <div class="module-switch" aria-label="檢視清單">
                    <button class="secondary" type="button" @onclick="StartNew">新增</button>
                    @if (_documents.Count == 0)
                    {
                        <p class="empty">還沒有檢視。從左側挑一張資料表開始。</p>
                    }
                    else
                    {
                        @foreach (var view in _documents)
                        {
                            <button type="button" class="secondary index-item" aria-current="@(MarkCurrent(view))" @onclick="() => Open(view)">
                                <span>@view.Name</span>
                                <span class="meta">@(view.Published ? "已發布" : "尚未發布")</span>
                            </button>
                        }
                    }
                </div>
                <div class="board-title">
                    <h2 id="view-editor-title">@(_editing ? (string.IsNullOrWhiteSpace(_name) ? AutomaticName() : _name) : "定義報表要讀的資料")</h2>
                    @if (_editing)
                    {
                        <p class="meta">@(_published ? "已發布。產生報表時會用到它。" : "尚未發布。發布之後，報表才叫得到。")@(_status.Length > 0 ? " " + _status : "")</p>
                    }
                    else
                    {
                        <p class="meta">選一張資料表，勾要看的欄。相關的表可以一起拖進來。預覽不讀取業務列。</p>
                    }
                </div>
                @if (_editing)
                {
                    <div class="actions">
                        <button class="secondary" type="button" aria-pressed="@(!_showSql)" @onclick="() => _showSql = false">圖像</button>
                        <button class="secondary" type="button" aria-pressed="@_showSql" @onclick="() => _showSql = true">SQL</button>
                        <button class="secondary" type="button" aria-pressed="@_assist" @onclick="() => _assist = !_assist">助理</button>
                        <button class="secondary" type="button" disabled="@_busy" @onclick="Save">儲存</button>
                        <button class="confirm" type="button" disabled="@_busy" @onclick="Publish">發布</button>
                    </div>
                }
                else
                {
                    <button class="confirm" type="button" @onclick="StartNew">開始定義</button>
                }
            </div>
            @if (!_editing)
            {
                <div class="canvas empty-canvas @( _dragOver ? "drag-over" : null)"
                     @ondragenter="() => _dragOver = true"
                     @ondragleave="() => _dragOver = false"
                     @ondragover:preventDefault="true"
                     @ondrop="Drop"
                     @ondrop:preventDefault="true">
                    <p>從左側點一張資料表，或拖到這裡。</p>
                    <p class="meta">不用手打表名或欄名。外鍵會帶出直接相關的表，也可以再往外一層。</p>
                </div>
            }
            else
            {
                <label class="stack name-line" for="view-name">名稱
                    <input id="view-name" autocomplete="off" placeholder="@AutomaticName()" @bind="_name" @bind:event="oninput" />
                </label>
                <p class="hint">可以空白，會用資料表的名字。</p>
                <label class="choice"><input type="checkbox" @bind="_confirmed" /> 解說已確認</label>
                @if (_assist)
                {
                    <form class="prop-panel" @onsubmit="Propose" @onsubmit:preventDefault="true">
                        <label class="stack" for="assist-ask">想看的內容
                            <textarea id="assist-ask" @bind="_ask" @bind:event="oninput"></textarea>
                        </label>
                        <label class="stack" for="assist-grain">一列代表什麼
                            <input id="assist-grain" autocomplete="off" @bind="_grain" @bind:event="oninput" />
                        </label>
                        <label class="stack" for="assist-wanted">希望出現的欄位或概念
                            <input id="assist-wanted" autocomplete="off" @bind="_wanted" @bind:event="oninput" />
                        </label>
                        <label class="stack" for="assist-filter">篩選
                            <input id="assist-filter" autocomplete="off" @bind="_assistFilter" @bind:event="oninput" />
                        </label>
                        <label class="stack" for="assist-limit">筆數
                            <input id="assist-limit" autocomplete="off" @bind="_assistLimit" @bind:event="oninput" />
                        </label>
                        <button class="confirm" type="submit" disabled="@_proposing">產生提案</button>
                        @if (!string.IsNullOrEmpty(_proposalNote))
                        {
                            <p role="status">@_proposalNote</p>
                        }
                        @if (_proposal is not null)
                        {
                            <ul>
                                @foreach (var source in _proposal.Sources)
                                {
                                    <li>@source：@ReasonFor(source)</li>
                                }
                                @foreach (var link in _proposal.Links)
                                {
                                    <li>@link.From.@link.FromColumn → @link.To.@link.ToColumn。@link.Reason</li>
                                }
                            </ul>
                            <div class="actions">
                                <button class="confirm" type="button" @onclick="AcceptProposal">接受提案</button>
                                <button class="secondary" type="button" @onclick="DeclineProposal">先不要</button>
                            </div>
                        }
                    </form>
                }
                @if (_showSql)
                {
                    <pre class="sql-read">@(string.IsNullOrWhiteSpace(_sql) ? (string.IsNullOrWhiteSpace(_previewNote) ? "結構還沒編成 SQL。" : _previewNote) : _sql)</pre>
                }
                else
                {
                <div class="canvas @( _dragOver ? "drag-over" : null)"
                     @ondragenter="() => _dragOver = true"
                     @ondragleave="() => _dragOver = false"
                     @ondragover:preventDefault="true"
                     @ondrop="Drop"
                     @ondrop:preventDefault="true">
                    @if (_sources.Count == 0)
                    {
                        <p class="empty">把資料表拖到這裡，或直接點左側的表名。</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_hint))
                        {
                            <div class="hint-row" role="status">
                                <p>@_hint</p>
                                @if (!string.IsNullOrEmpty(_switchCandidate))
                                {
                                    <button class="secondary" type="button" @onclick="SwitchRoot">改以 @_switchCandidate 當起點</button>
                                }
                            </div>
                        }
                        <div class="card-stage" style="@StageStyle()" @onpointermove="MoveCard" @onpointerup="EndCardMove">
                            <svg class="link-layer" aria-hidden="true">
                                @foreach (var link in _links)
                                {
                                    var line = LinkLine(link);
                                    <line x1="@line.X1" y1="@line.Y1" x2="@line.X2" y2="@line.Y2" />
                                }
                            </svg>
                            @foreach (var source in _sources)
                            {
                                var table = Card(source);
                                var missing = !Known(source);
                                <article class="table-card" aria-label="@source" style="@CardStyle(source)">
                                    <header @onpointerdown="args => StartCardMove(source, args)">
                                        <div>
                                            <h3>@source</h3>
                                            <p class="meta">@(IsRoot(source) ? "起點" : $"第 {Layer(source)} 層")@(missing ? " · 目前連線裡找不到" : "")</p>
                                        </div>
                                        <button class="secondary" type="button" @onpointerdown:stopPropagation="true" @onclick="() => RemoveTable(source)">移出</button>
                                    </header>
                                    @if (table.Columns.Count == 0)
                                    {
                                        <p class="empty">沒有欄位。</p>
                                    }
                                    else
                                    {
                                        <div class="actions">
                                            <button class="secondary" type="button" @onclick="() => SelectAll(table)">全選這張表</button>
                                            <button class="secondary" type="button" @onclick="() => ClearColumns(source)">清除勾選</button>
                                        </div>
                                        <ul class="field-list">
                                            @foreach (var column in table.Columns)
                                            {
                                                var current = column;
                                                <li @ondragover:preventDefault="true" @ondrop="() => DropColumn(source, current.Name)" @ondrop:preventDefault="true">
                                                    <label class="choice">
                                                        <input type="checkbox" checked="@ColumnOn(source, current.Name)" @onchange="args => ToggleColumn(source, current.Name, Checked(args))" />
                                                        <span>@current.Name</span>
                                                        @if (!string.IsNullOrWhiteSpace(current.Type))
                                                        {
                                                            <span class="meta">@current.Type</span>
                                                        }
                                                        @if (current.PrimaryKey)
                                                        {
                                                            <span class="badge">主鍵</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(current.ReferencesTable))
                                                        {
                                                            <span class="badge">連到 @current.ReferencesTable.@current.ReferencesColumn</span>
                                                        }
                                                    </label>
                                                    <button type="button" class="link-handle" draggable="true" aria-label="@($"從 {source}.{current.Name} 拉關聯")" @ondragstart="() => BeginColumnDrag(source, current.Name)" @ondragstart:stopPropagation="true" @ondragend="EndColumnDrag" @onpointerdown:stopPropagation="true">拉線</button>
                                                    <label class="choice quiet">
                                                        <input type="checkbox" checked="@FilterOn(source, current.Name)" @onchange="args => ToggleFilter(source, current.Name, Checked(args))" />
                                                        <span>當作篩選</span>
                                                    </label>
                                                    @if (FilterOn(source, current.Name))
                                                    {
                                                        <label class="stack spoken">問法
                                                            <input autocomplete="off" value="@Spoken(source, current.Name)" @oninput="args => RenameFilter(source, current.Name, args)" />
                                                        </label>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </article>
                            }
                        </div>
                        @if (_links.Count > 0)
                        {
                            <ul class="link-list" aria-label="表怎麼相連">
                                @foreach (var link in _links)
                                {
                                    var current = link;
                                    <li>
                                        <span class="code">@current.From.@current.FromColumn → @current.To.@current.ToColumn</span>
                                        <select aria-label="連接方式" value="@JoinValue(current)" @onchange="args => SetJoin(current, args)">
                                            <option value="inner">內連接</option>
                                            <option value="left">左連接</option>
                                        </select>
                                        <button class="secondary" type="button" @onclick="() => RemoveLink(current)">移除</button>
                                        @if (current.ViewOnly)
                                        {
                                            <label class="stack">僅此檢視的理由
                                                <input autocomplete="off" value="@current.Reason" @oninput="args => current.Reason = args.Value?.ToString() ?? string.Empty" />
                                            </label>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        <div class="relate">
                            <div class="depth" role="group" aria-label="要看到多遠的關聯">
                                <button type="button" class="secondary" aria-pressed="@(_depth == 1)" @onclick="() => SetDepth(1)">直接相關</button>
                                <button type="button" class="secondary" aria-pressed="@(_depth == 2)" @onclick="() => SetDepth(2)">再往外一層</button>
                            </div>
                            @if (OpenSuggestions.Count == 0)
                            {
                                <p class="empty">@SuggestionEmpty()</p>
                            }
                            else
                            {
                                <div class="chip-row" role="group" aria-label="可以一起看的資料表">
                                    @foreach (var suggestion in OpenSuggestions)
                                    {
                                        var current = suggestion;
                                        <button type="button" class="chip" @onclick="() => AddSuggestion(current)">
                                            @current.Table
                                            @if (current.Depth > 1)
                                            {
                                                <span class="meta">經過 @current.Parent</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="prop-panel">
                            <label class="choice"><input type="checkbox" @bind="_distinct" @bind:after="SchedulePreview" /> 不重複</label>
                            <label class="stack" for="row-limit">筆數
                                <input id="row-limit" inputmode="numeric" autocomplete="off" value="@_limitText" @oninput="SetLimit" />
                            </label>
                            <p class="meta">沒有填筆數時，預覽最多 100 列。</p>
                            @foreach (var filter in _filters)
                            {
                                var current = filter;
                                <div class="filter-grid">
                                    <input aria-label="條件表" value="@current.Source" @oninput="args => current.Source = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="條件欄" value="@current.Column" @oninput="args => current.Column = args.Value?.ToString() ?? string.Empty" />
                                    <select aria-label="條件運算子" value="@current.Operator" @onchange="args => SetOperator(current, args)">
                                        <option>=</option><option>&lt;&gt;</option><option>&gt;</option><option>&lt;</option><option>&gt;=</option><option>&lt;=</option><option>LIKE</option><option>IN</option><option>IS NULL</option><option>IS NOT NULL</option>
                                    </select>
                                    <input aria-label="條件值" value="@current.Value" @oninput="args => current.Value = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="條件參數" placeholder="參數名" value="@current.Parameter" @oninput="args => current.Parameter = args.Value?.ToString() ?? string.Empty" />
                                    <button class="secondary" type="button" @onclick="() => RemoveFilter(current)">移除條件</button>
                                </div>
                            }
                            <button class="secondary" type="button" @onclick="AddFilter">加條件</button>
                            <button class="secondary" type="button" @onclick="AddGroup">加分組</button>
                            @foreach (var group in _groupBy)
                            {
                                var current = group;
                                <div class="filter-grid">
                                    <input aria-label="分組表" value="@current.Source" @oninput="args => current.Source = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="分組欄" value="@current.Column" @oninput="args => current.Column = args.Value?.ToString() ?? string.Empty" />
                                </div>
                            }
                            <button class="secondary" type="button" @onclick="AddAggregate">加彙總</button>
                            @foreach (var aggregate in _aggregates)
                            {
                                var current = aggregate;
                                <div class="filter-grid">
                                    <select aria-label="彙總函數" value="@current.Function" @onchange="args => SetFunction(current, args)">
                                        <option value="count">COUNT</option><option value="sum">SUM</option><option value="avg">AVG</option><option value="min">MIN</option><option value="max">MAX</option>
                                    </select>
                                    <input aria-label="彙總表" value="@current.Source" @oninput="args => current.Source = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="彙總欄" value="@current.Column" @oninput="args => current.Column = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="彙總名稱" value="@current.Alias" @oninput="args => current.Alias = args.Value?.ToString() ?? string.Empty" />
                                </div>
                            }
                            @foreach (var having in _having)
                            {
                                var current = having;
                                <div class="filter-grid">
                                    <input aria-label="彙總條件" value="@current.Column" @oninput="args => current.Column = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="彙總條件值" value="@current.Value" @oninput="args => current.Value = args.Value?.ToString() ?? string.Empty" />
                                </div>
                            }
                            <button class="secondary" type="button" @onclick="AddHaving">加彙總條件</button>
                            <button class="secondary" type="button" @onclick="AddOrder">加排序</button>
                            @foreach (var order in _orderBy)
                            {
                                var current = order;
                                <div class="filter-grid">
                                    <input aria-label="排序表" value="@current.Source" @oninput="args => current.Source = args.Value?.ToString() ?? string.Empty" />
                                    <input aria-label="排序欄" value="@current.Column" @oninput="args => current.Column = args.Value?.ToString() ?? string.Empty" />
                                    <select aria-label="排序方向" value="@current.Direction" @onchange="args => SetDirection(current, args)">
                                        <option value="asc">由小到大</option>
                                        <option value="desc">由大到小</option>
                                    </select>
                                </div>
                            }
                            <button class="secondary" type="button" @onclick="AddManualLink">加上關聯</button>
                        </div>
                    }
                </div>
                }
                <section class="preview" aria-label="查詢結果">
                    <div class="preview-bar">
                        <h3>查詢結果</h3>
                        @if (!string.IsNullOrEmpty(QuerySentence()))
                        {
                            <p class="meta">@QuerySentence()</p>
                        }
                    </div>
                    @if (_parameters.Count > 0)
                    {
                        <div class="filter-grid">
                            @foreach (var parameter in _parameters)
                            {
                                var current = parameter;
                                <label class="stack">@current.Name
                                    <input autocomplete="off" placeholder="留白表示先不篩" value="@ValueOf(current.Name)" @oninput="args => SetValue(current.Name, args)" />
                                </label>
                            }
                        </div>
                    }
                    <div role="status" aria-live="polite">
                        @if (_previewing)
                        {
                            <p class="meta">正在準備預覽。</p>
                        }
                        else if (!string.IsNullOrEmpty(_previewNote))
                        {
                            <p class="meta">@_previewNote</p>
                        }
                    </div>
                    @if (_previewColumns.Count == 0)
                    {
                        @if (string.IsNullOrEmpty(_previewNote) && !_previewing)
                        {
                            <p class="empty">勾選欄位後，這裡會顯示預覽說明。篩選可以留白。</p>
                        }
                    }
                    else
                    {
                        <div class="grid-wrap">
                            <table>
                                <thead>
                                    <tr>@foreach (var column in _previewColumns) { <th>@column</th> }</tr>
                                </thead>
                                <tbody>
                                    @if (_previewRows.Count == 0)
                                    {
                                        <tr><td colspan="@Math.Max(_previewColumns.Count, 1)">沒有符合的資料。</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _previewRows)
                                        {
                                            <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        </section>
    </div>
}

@code {
    private bool _denied;
    private bool _closed;
    private EnvironmentSnapshot _snapshot = EnvironmentSnapshot.NotReady;
    private bool _editing;
    private bool _creating;
    private bool _busy;
    private bool _published;
    private bool _confirmed;
    private bool _schemaBusy;
    private bool _previewing;
    private bool _dragOver;
    private int _depth = 1;
    private int _previewGeneration;
    private ErrorDto? _error;
    private string? _local;
    private ErrorDto? _schemaError;
    private string? _hint;
    private string? _switchCandidate;
    private string? _drag;
    private string? _dragColumnTable;
    private string? _dragColumn;
    private string? _movingCard;
    private double _moveX;
    private double _moveY;
    private string _previewNote = "";
    private string _status = "";
    private string _id = "";
    private string _name = "";
    private string _purpose = "";
    private string _query = "";
    private string _sql = "";
    private string _limitText = "";
    private string _ask = "";
    private string _grain = "";
    private string _wanted = "";
    private string _assistFilter = "";
    private string _assistLimit = "";
    private string _proposalNote = "";
    private bool _showSql;
    private bool _assist;
    private bool _distinct;
    private bool _proposing;
    private int? _limit;
    private ViewProposalDto? _proposal;
    private AnnotationPackageDto? _package;
    private readonly HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);
    private List<ViewFilterDto> _filters = [];
    private List<ViewGroupDto> _groupBy = [];
    private List<ViewAggregateDto> _aggregates = [];
    private List<ViewFilterDto> _having = [];
    private List<ViewOrderDto> _orderBy = [];
    private List<ViewPlacementDto> _placements = [];
