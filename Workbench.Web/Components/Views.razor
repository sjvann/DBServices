    private void AddManualLink()
    {
        if (_sources.Count < 2)
        {
            _local = "要先放進兩張資料表。";
            return;
        }

        var from = Card(_sources[0]);
        var to = Card(_sources[1]);
        if (from.Columns.Count == 0 || to.Columns.Count == 0)
        {
            _local = "這兩張表沒有欄位可以連。";
            return;
        }

        var origin = DeclaredOrigin(from.Name, from.Columns[0].Name, to.Name, to.Columns[0].Name);
        _links.Add(new ViewLinkDto
        {
            Kind = origin == "declared" ? "accepted" : origin == "foreign-key" ? "foreign-key" : "accepted",
            From = from.Name,
            FromColumn = from.Columns[0].Name,
            To = to.Name,
            ToColumn = to.Columns[0].Name,
            Join = "inner",
            ViewOnly = origin is null,
        });
        _local = origin is null ? "這段關聯只留在這份檢視，請寫理由。" : null;
    }

    private string ReasonFor(string source)
        => _proposal?.Reasons.TryGetValue(source, out var reason) == true ? reason : "";

    private async Task Propose()
    {
        _proposal = null;
        _proposalNote = "";
        if (string.IsNullOrWhiteSpace(_ask) && string.IsNullOrWhiteSpace(_wanted))
        {
            _proposalNote = "請先描述想看的內容。";
            return;
        }

        _proposing = true;
        try
        {
            var result = await Proposer.ProposeAsync(new ViewProposalRequest
            {
                Ask = _ask,
                Grain = _grain,
                Wanted = _wanted,
                Filter = _assistFilter,
                Limit = _assistLimit,
                Package = _package,
                Scope = _sources.Count == 0 ? [] : AnnotationProposalTools.CanvasScope(_package, _sources),
            }, CancellationToken.None);
            if (!result.Ok || result.Proposal is null)
            {
                _proposalNote = result.Message;
                return;
            }

            _proposal = result.Proposal;
            _proposalNote = "可以接受這份提案，或先不要。";
        }
        finally
        {
            _proposing = false;
        }
    }

    private void AcceptProposal()
    {
        var proposal = _proposal;
        if (proposal is null)
            return;
        if (!_editing)
            StartNew();
        _sources = proposal.Sources.ToList();
        _links = proposal.Links.Select(link => new ViewLinkDto
        {
            Kind = link.Kind,
            From = link.From,
            FromColumn = link.FromColumn,
            To = link.To,
            ToColumn = link.ToColumn,
            Join = string.IsNullOrWhiteSpace(link.Join) ? "inner" : link.Join,
            Reason = link.Reason,
            ViewOnly = link.ViewOnly,
        }).ToList();
        _columns = proposal.Columns.Select(column => new ViewColumnDto { Name = column.Name, Source = column.Source }).ToList();
        _filters = (proposal.Filters ?? []).ToList();
        _limit = proposal.Limit;
        _limitText = proposal.Limit?.ToString() ?? _assistLimit;
        if (!string.IsNullOrWhiteSpace(_grain))
            _purpose = _grain.Trim();
        _proposalNote = "已放到畫布。";
        _proposal = null;
        _showSql = false;
        SchedulePreview();
    }

    private void DeclineProposal()
    {
        _proposal = null;
        _proposalNote = "畫布維持原樣。";
    }

    private void BeginDrag(string table) => _drag = table;

    private void BeginColumnDrag(string table, string column)
    {
        _dragColumnTable = table;
        _dragColumn = column;
        _drag = null;
    }

    private void EndColumnDrag()
    {
        _dragColumnTable = null;
        _dragColumn = null;
    }

    private void DropColumn(string table, string column)
    {
        var fromTable = _dragColumnTable;
        var fromColumn = _dragColumn;
        _dragColumnTable = null;
        _dragColumn = null;
        if (string.IsNullOrWhiteSpace(fromTable) || string.IsNullOrWhiteSpace(fromColumn))
            return;
        if (string.Equals(fromTable, table, StringComparison.OrdinalIgnoreCase)
            && string.Equals(fromColumn, column, StringComparison.OrdinalIgnoreCase))
            return;
        if (_links.Any(link => SameEnds(link, fromTable, fromColumn, table, column)))
            return;

        var origin = DeclaredOrigin(fromTable, fromColumn, table, column);
        _links.Add(new ViewLinkDto
        {
            Kind = origin == "declared" ? "accepted" : origin == "foreign-key" ? "foreign-key" : "accepted",
            From = fromTable,
            FromColumn = fromColumn,
            To = table,
            ToColumn = column,
            Join = "inner",
            ViewOnly = origin is null,
        });
        _local = origin is null ? "這段關聯只留在這份檢視，請寫理由。" : null;
        SchedulePreview();
    }

    private static bool SameEnds(ViewLinkDto link, string fromTable, string fromColumn, string toTable, string toColumn)
        => string.Equals(link.From, fromTable, StringComparison.OrdinalIgnoreCase)
            && string.Equals(link.FromColumn, fromColumn, StringComparison.OrdinalIgnoreCase)
            && string.Equals(link.To, toTable, StringComparison.OrdinalIgnoreCase)
            && string.Equals(link.ToColumn, toColumn, StringComparison.OrdinalIgnoreCase);

    private void RemoveLink(ViewLinkDto link)
    {
        _links.Remove(link);
        SchedulePreview();
    }

    private void StartCardMove(string table, PointerEventArgs args)
    {
        if (args.Button != 0)
            return;
        _movingCard = table;
        _moveX = args.ClientX;
        _moveY = args.ClientY;
        EnsurePlacement(table);
    }

    private void MoveCard(PointerEventArgs args)
    {
        if (_movingCard is null)
            return;
        var place = EnsurePlacement(_movingCard);
        place.X = Math.Max(0, place.X + args.ClientX - _moveX);
        place.Y = Math.Max(0, place.Y + args.ClientY - _moveY);
        _moveX = args.ClientX;
        _moveY = args.ClientY;
    }

    private void EndCardMove() => _movingCard = null;

    private string CardStyle(string table)
    {
        var index = Math.Max(0, _sources.FindIndex(item => string.Equals(item, table, StringComparison.OrdinalIgnoreCase)));
        var (x, y) = Point(table, index);
        return $"left:{x:0}px;top:{y:0}px;";
    }

    private string StageStyle()
    {
        var bottom = 280d;
        for (var index = 0; index < _sources.Count; index++)
        {
            var (_, y) = Point(_sources[index], index);
            bottom = Math.Max(bottom, y + 320);
        }

        return $"height:{bottom:0}px";
    }

    private (double X1, double Y1, double X2, double Y2) LinkLine(ViewLinkDto link)
    {
        var from = Anchor(link.From, link.FromColumn);
        var to = Anchor(link.To, link.ToColumn);
        return (from.X, from.Y, to.X, to.Y);
    }

    private (double X, double Y) Anchor(string? table, string? column)
    {
        var name = table ?? "";
        var index = Math.Max(0, _sources.FindIndex(item => string.Equals(item, name, StringComparison.OrdinalIgnoreCase)));
        var (x, y) = Point(name, index);
        var card = Card(name);
        var columnIndex = card.Columns.FindIndex(item => string.Equals(item.Name, column, StringComparison.OrdinalIgnoreCase));
        if (columnIndex < 0)
            columnIndex = 0;
        return (x + 130, y + 96 + columnIndex * 36);
    }

    private (double X, double Y) Point(string table, int index)
    {
        var found = _placements.FirstOrDefault(item => string.Equals(item.Table, table, StringComparison.OrdinalIgnoreCase));
        if (found is not null)
            return (found.X, found.Y);
        return (16 + (index % 3) * 280, 16 + (index / 3) * 260);
    }

    private ViewPlacementDto EnsurePlacement(string table)
    {
        var found = _placements.FirstOrDefault(item => string.Equals(item.Table, table, StringComparison.OrdinalIgnoreCase));
        if (found is not null)
            return found;
        var index = Math.Max(0, _sources.FindIndex(item => string.Equals(item, table, StringComparison.OrdinalIgnoreCase)));
        var (x, y) = Point(table, index);
        found = new ViewPlacementDto { Table = table, X = x, Y = y };
        _placements.Add(found);
        return found;
    }

    private void EndDrag()
    {
        _drag = null;
        _dragOver = false;
    }

    private void Drop()
    {
        _dragOver = false;
        if (!string.IsNullOrWhiteSpace(_drag))
            Place(_drag);
        _drag = null;
    }

    private void Place(string table)
    {
        if (!_editing)
            StartNew();
        var name = Canonical(table);
        if (name.Length == 0)
            return;
        if (_sources.Count == 0)
        {
            _sources.Add(name);
            _hint = null;
            _switchCandidate = null;
            return;
        }

        if (Placed(name))
            return;

        var suggestion = Suggestions(2).FirstOrDefault(item => string.Equals(item.Table, name, StringComparison.OrdinalIgnoreCase));
        if (suggestion is null)
        {
            _switchCandidate = name;
            _hint = $"{name} 和起點之間沒有兩層以內的關聯。";
            return;
        }

        if (suggestion.Depth > _depth)
            _depth = suggestion.Depth;
        _hint = null;
        _switchCandidate = null;
        AddSuggestion(suggestion);
    }

    private void AddSuggestion(SchemaNeighborhood.Suggestion suggestion)
    {
        if (!Placed(suggestion.Parent) && !string.Equals(suggestion.Parent, Root, StringComparison.OrdinalIgnoreCase))
        {
            var parent = Suggestions(suggestion.Depth).FirstOrDefault(item => string.Equals(item.Table, suggestion.Parent, StringComparison.OrdinalIgnoreCase));
            if (parent is not null)
                AddSuggestion(parent);
        }

        if (!Placed(suggestion.Table))
            _sources.Add(suggestion.Table);
        if (!_links.Any(link => SameLink(link, suggestion)))
        {
            _links.Add(new ViewLinkDto
            {
                Kind = KindFor(suggestion),
                From = suggestion.From,
                FromColumn = suggestion.FromColumn,
                To = suggestion.To,
                ToColumn = suggestion.ToColumn,
            });
        }

        _hint = null;
        _switchCandidate = null;
    }

    private void SwitchRoot()
    {
        var name = _switchCandidate;
        if (string.IsNullOrWhiteSpace(name))
            return;
        _sources = [name];
        _links = [];
        _columns = [];
        _parameters = [];
        _values.Clear();
        _hint = null;
        _switchCandidate = null;
        _previewColumns = [];
        _previewRows = [];
        _previewNote = "";
    }

    private void RemoveTable(string table)
    {
        if (IsRoot(table))
        {
            _sources = [];
            _links = [];
            _columns = [];
            _parameters = [];
            _values.Clear();
            _previewColumns = [];
            _previewRows = [];
            _previewNote = "";
            return;
        }

        _sources.RemoveAll(item => string.Equals(item, table, StringComparison.OrdinalIgnoreCase));
        _links.RemoveAll(link => string.Equals(link.From, table, StringComparison.OrdinalIgnoreCase) || string.Equals(link.To, table, StringComparison.OrdinalIgnoreCase));
        _columns.RemoveAll(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase));
        foreach (var parameter in _parameters.Where(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase)).ToList())
            _values.Remove(parameter.Name);
        _parameters.RemoveAll(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase));
        Prune();
        SchedulePreview();
    }

    private void Prune()
    {
        if (_sources.Count == 0)
            return;
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { Root };
        var pending = new Queue<string>();
        pending.Enqueue(Root);
        while (pending.Count > 0)
        {
            var node = pending.Dequeue();
            foreach (var link in _links)
            {
                string? next = null;
                if (string.Equals(link.From, node, StringComparison.OrdinalIgnoreCase))
                    next = link.To;
                else if (string.Equals(link.To, node, StringComparison.OrdinalIgnoreCase))
                    next = link.From;
                if (next is not null && seen.Add(next))
                    pending.Enqueue(next);
            }
        }

        var dropped = _sources.Where(item => !seen.Contains(item)).ToList();
        if (dropped.Count == 0)
            return;
        foreach (var source in dropped)
        {
            _sources.RemoveAll(item => string.Equals(item, source, StringComparison.OrdinalIgnoreCase));
            _links.RemoveAll(link => string.Equals(link.From, source, StringComparison.OrdinalIgnoreCase) || string.Equals(link.To, source, StringComparison.OrdinalIgnoreCase));
            _columns.RemoveAll(item => string.Equals(item.Source, source, StringComparison.OrdinalIgnoreCase));
            foreach (var parameter in _parameters.Where(item => string.Equals(item.Source, source, StringComparison.OrdinalIgnoreCase)).ToList())
                _values.Remove(parameter.Name);
            _parameters.RemoveAll(item => string.Equals(item.Source, source, StringComparison.OrdinalIgnoreCase));
        }

        Prune();
    }

    private void SetDepth(int depth) => _depth = depth;

    private void SelectAll(SchemaTableDto table)
    {
        foreach (var column in table.Columns)
        {
            if (!ColumnOn(table.Name, column.Name))
                _columns.Add(new ViewColumnDto { Name = column.Name, Source = table.Name });
        }

        SchedulePreview();
    }

    private void ClearColumns(string table)
    {
        _columns.RemoveAll(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase));
        SchedulePreview();
    }

    private void ToggleColumn(string table, string column, bool selected)
    {
        if (selected)
        {
            if (!ColumnOn(table, column))
                _columns.Add(new ViewColumnDto { Name = column, Source = table });
        }
        else
        {
            _columns.RemoveAll(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Name, column, StringComparison.OrdinalIgnoreCase));
        }

        SchedulePreview();
    }

    private void ToggleFilter(string table, string column, bool selected)
    {
        var current = FindParameter(table, column);
        if (selected)
        {
            if (current is not null)
                return;
            _parameters.Add(new ViewParameterDto { Name = UniqueSpoken(column), Column = column, Source = table });
        }
        else if (current is not null)
        {
            _values.Remove(current.Name);
            _parameters.Remove(current);
        }

        SchedulePreview();
    }

    private void RenameFilter(string table, string column, ChangeEventArgs args)
    {
        var current = FindParameter(table, column);
        if (current is null)
            return;
        var previous = current.Name;
        var next = Text(args).Trim();
        if (next.Length == 0)
            next = column;
        if (string.Equals(previous, next, StringComparison.Ordinal))
            return;
        if (_values.TryGetValue(previous, out var value))
        {
            _values.Remove(previous);
            _values[next] = value;
        }

        current.Name = next;
        SchedulePreview();
    }

    private void SetValue(string name, ChangeEventArgs args)
    {
        _values[name] = Text(args);
        SchedulePreview();
    }

    private bool ColumnOn(string table, string column)
        => _columns.Any(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Name, column, StringComparison.OrdinalIgnoreCase));

    private bool FilterOn(string table, string column)
        => FindParameter(table, column) is not null;

    private string Spoken(string table, string column) => FindParameter(table, column)?.Name ?? column;

    private string ValueOf(string name) => _values.TryGetValue(name, out var value) ? value : "";

    private ViewParameterDto? FindParameter(string table, string column)
        => _parameters.FirstOrDefault(item => string.Equals(item.Source, table, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Column, column, StringComparison.OrdinalIgnoreCase));

    private string UniqueSpoken(string column)
    {
        if (_parameters.All(item => !string.Equals(item.Name, column, StringComparison.OrdinalIgnoreCase)))
            return column;
        return column + " " + (_parameters.Count + 1);
    }

    private bool Placed(string table) => _sources.Any(item => string.Equals(item, table, StringComparison.OrdinalIgnoreCase));

    private bool IsRoot(string table) => string.Equals(Root, table, StringComparison.OrdinalIgnoreCase);

    private bool Known(string table) => _tables.Any(item => string.Equals(item.Name, table, StringComparison.OrdinalIgnoreCase));

    private string TableState(string table)
    {
        if (!_editing || _sources.Count == 0)
            return "點一下當起點";
        if (IsRoot(table))
            return "起點";
        if (Placed(table))
            return "已加入";
        var suggestion = Suggestions(2).FirstOrDefault(item => string.Equals(item.Table, table, StringComparison.OrdinalIgnoreCase));
        if (suggestion is null)
            return "可改當起點";
        return suggestion.Depth == 1 ? "可直接加入" : "再往外一層";
    }

    private int Layer(string table)
        => Suggestions(2).FirstOrDefault(item => string.Equals(item.Table, table, StringComparison.OrdinalIgnoreCase))?.Depth ?? 1;

    private IReadOnlyList<SchemaNeighborhood.Suggestion> Suggestions(int depth)
        => string.IsNullOrWhiteSpace(Root) ? [] : SchemaNeighborhood.Suggest(WithHiddenEdges(_tables), Root, depth);

    private SchemaTableDto Card(string source)
    {
        var found = _tables.FirstOrDefault(item => string.Equals(item.Name, source, StringComparison.OrdinalIgnoreCase));
        if (found is not null)
            return found;
        var columns = _columns
            .Where(item => string.Equals(item.Source, source, StringComparison.OrdinalIgnoreCase))
            .Select(item => new SchemaColumnDto { Name = item.Name })
            .ToList();
        return new SchemaTableDto { Name = source, Columns = columns };
    }

    private string SuggestionEmpty()
    {
        if (Suggestions(2).Any(item => item.Depth == 2) && _depth == 1 && OpenSuggestions.Count == 0)
            return "沒有更近的表了。可以改看再往外一層。";
        return _depth == 1 ? "這張表沒有直接相連的資料表。" : "再往外也沒有相連的資料表。";
    }

    private string QuerySentence()
    {
        if (_columns.Count == 0)
            return "";
        var parts = new List<string>();
        foreach (var source in _sources)
        {
            var names = _columns
                .Where(item => string.Equals(item.Source, source, StringComparison.OrdinalIgnoreCase))
                .Select(item => item.Name)
                .Where(item => item.Length > 0)
                .ToList();
            if (names.Count > 0)
                parts.Add(source + " 的 " + string.Join("、", names));
        }

        return parts.Count == 0 ? "" : "這份檢視會取出 " + string.Join("，以及 ", parts) + "。";
    }

    private string AutomaticName() => _sources.Count == 0 ? "新檢視" : string.Join("、", _sources);

    private void SchedulePreview()
    {
        var generation = ++_previewGeneration;
        _ = PreviewLater(generation);
    }

    private async Task PreviewLater(int generation)
    {
        try
        {
            await Task.Delay(350);
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        if (generation != _previewGeneration)
            return;
        await InvokeAsync(() => RunPreview(generation));
    }

    private async Task RunPreview(int generation)
    {
        if (generation != _previewGeneration)
            return;
        if (_sources.Count == 0 || _columns.Count == 0)
        {
            _previewing = false;
            _previewColumns = [];
            _previewRows = [];
            _sql = "";
            _previewNote = "";
            StateHasChanged();
            return;
        }

        CancelPreview();
        var cts = new CancellationTokenSource();
        _previewCts = cts;
        _previewing = true;
        _previewNote = "";
        StateHasChanged();
        try
        {
            var document = Draft();
            var result = await Schema.PreviewAsync(Gate.Current!.Id, document, _values, cts.Token);
            if (generation != _previewGeneration)
                return;
            if (!result.Ok)
            {
                _previewColumns = [];
                _previewRows = [];
                _sql = "";
                _previewNote = result.Error!.Message;
                return;
            }

            _previewColumns = result.Value!.Columns ?? [];
            _previewRows = result.Value.Rows ?? [];
            _sql = result.Value.Sql ?? "";
            _previewNote = result.Value.Truncated
                ? "只顯示前 " + _previewRows.Count + " 列。"
                : _previewRows.Count == 0 ? "" : _previewRows.Count + " 列";
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (generation == _previewGeneration)
            {
                _previewing = false;
                StateHasChanged();
            }
        }
    }

    private void CancelPreview()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        _previewCts = null;
    }

    private async Task Save() => await Write(false);

    private async Task Publish() => await Write(true);

    private async Task Write(bool publish)
    {
        if (_busy)
            return;
        var document = Build(out var problem);
        if (document is null)
        {
            _local = problem;
            _error = null;
            return;
        }

        var profile = Gate.Current!;
        _busy = true;
        _local = null;
        _error = null;
        try
        {
            if (!_creating)
            {
                var existing = await ViewEditor.ReadAsync(profile.Id, document.Id, CancellationToken.None);
                if (existing.Ok && existing.Value is not null)
                    document.Published = existing.Value.Published;
                else if (existing.Error?.Code != "not_found")
                {
                    _error = existing.Error;
                    return;
                }
            }

            if (_schemaError is not null)
            {
                _error = _schemaError;
                return;
            }

            var previousKinds = (document.Links ?? []).Select(link => link.Kind).ToArray();
            if (RefuseUndeclared(document) is { } refused)
            {
                _error = refused;
                return;
            }

            OpResult<ViewDocumentDto> saved;
            try
            {
                saved = await ViewEditor.SaveAsync(profile.Id, document, CancellationToken.None);
            }
            catch
            {
                RestoreKinds(document.Links, previousKinds);
                throw;
            }

            if (!saved.Ok)
            {
                RestoreKinds(document.Links, previousKinds);
                _error = saved.Error;
                return;
            }

            _id = saved.Value!.Id;
            _published = saved.Value.Published;
            _creating = false;
            Apply(saved.Value);
            if (!publish)
            {
                _local = null;
                _status = "已儲存。";
                await Reload(profile.Id);
                return;
            }

            var published = await ViewEditor.PublishAsync(profile.Id, _id, CancellationToken.None);
            if (!published.Ok)
            {
                _error = published.Error;
                await Reload(profile.Id);
                return;
            }

            _published = published.Value!.Published;
            Apply(published.Value);
            _status = "已發布。";
            await Reload(profile.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private ViewDocumentDto Draft()
    {
        var name = _name.Trim();
        if (name.Length == 0)
            name = AutomaticName();
        return new ViewDocumentDto
        {
            Id = _id.Trim(),
            Name = name,
            Purpose = string.IsNullOrWhiteSpace(_purpose) ? name : _purpose.Trim(),
            Confirmed = _confirmed,
            Published = _published,
            Sources = _sources.ToList(),
            Links = _links.ToList(),
            Columns = _columns.ToList(),
            Parameters = _parameters.ToList(),
            Limit = _limit,
            Distinct = _distinct,
            Filters = _filters.ToList(),
            GroupBy = _groupBy.ToList(),
            Aggregates = _aggregates.ToList(),
            Having = _having.ToList(),
            OrderBy = _orderBy.ToList(),
            Placements = _placements.ToList(),
            Sql = "",
        };
    }

    private ViewDocumentDto? Build(out string? problem)
    {
        problem = null;
        if (_sources.Count == 0)
        {
            problem = "請先選一張資料表。";
            return null;
        }

        if (_columns.Count == 0)
        {
            problem = "請勾選至少一個欄位。";
            return null;
        }

        var document = Draft();
        if (document.Name.Length == 0 || document.Name == "新檢視")
        {
            problem = "請先選一張資料表。";
            return null;
        }

        var incomplete = document.Parameters.Any(item => string.IsNullOrWhiteSpace(item.Name) || string.IsNullOrWhiteSpace(item.Column));
        if (incomplete)
        {
            problem = "每個篩選都要有問法。";
            return null;
        }

        _name = document.Name;
        _purpose = document.Purpose;
        return document;
    }

    private void Apply(ViewDocumentDto document)
    {
        _name = document.Name ?? "";
        _purpose = document.Purpose ?? "";
        _published = document.Published;
        _confirmed = document.Confirmed;
        _sources = (document.Sources ?? []).ToList();
        _links = (document.Links ?? []).ToList();
        _columns = (document.Columns ?? []).ToList();
        _parameters = (document.Parameters ?? []).ToList();
        CopyQuery(document);
    }

    private void CopyQuery(ViewDocumentDto document)
    {
        _limit = document.Limit;
        _limitText = document.Limit?.ToString() ?? "";
        _distinct = document.Distinct;
        _filters = (document.Filters ?? []).Select(item => new ViewFilterDto
        {
            Combiner = item.Combiner,
            Source = item.Source,
            Column = item.Column,
            Operator = item.Operator,
            Value = item.Value,
            Parameter = item.Parameter,
        }).ToList();
        _groupBy = (document.GroupBy ?? []).Select(item => new ViewGroupDto { Source = item.Source, Column = item.Column }).ToList();
        _aggregates = (document.Aggregates ?? []).Select(item => new ViewAggregateDto
        {
            Function = item.Function,
            Source = item.Source,
            Column = item.Column,
            Alias = item.Alias,
        }).ToList();
        _having = (document.Having ?? []).Select(item => new ViewFilterDto
        {
            Combiner = item.Combiner,
            Column = item.Column,
            Operator = string.IsNullOrWhiteSpace(item.Operator) ? ">" : item.Operator,
            Value = item.Value,
        }).ToList();
        _orderBy = (document.OrderBy ?? []).Select(item => new ViewOrderDto { Source = item.Source, Column = item.Column, Direction = item.Direction }).ToList();
        _placements = (document.Placements ?? []).Select(item => new ViewPlacementDto { Table = item.Table, X = item.X, Y = item.Y }).ToList();
        _sql = document.Sql ?? "";
    }

    private void Align()
    {
        _sources = _sources.Select(Canonical).Where(item => item.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        foreach (var link in _links)
        {
            link.From = Canonical(link.From);
            link.To = Canonical(link.To);
        }

        foreach (var column in _columns)
            column.Source = Canonical(column.Source);
        foreach (var parameter in _parameters)
            parameter.Source = Canonical(parameter.Source);
    }

    private string Canonical(string? name)
    {
        var text = name?.Trim() ?? "";
        var found = _tables.FirstOrDefault(item => string.Equals(item.Name, text, StringComparison.OrdinalIgnoreCase));
        return found?.Name ?? text;
    }

    private string KindFor(SchemaNeighborhood.Suggestion suggestion)
    {
        var origin = DeclaredOrigin(suggestion.From, suggestion.FromColumn, suggestion.To, suggestion.ToColumn);
        return origin == "declared" ? "accepted" : "foreign-key";
    }

    private ErrorDto? RefuseUndeclared(ViewDocumentDto document)
    {
        var sources = (document.Sources ?? [])
            .Select(source => source?.Trim() ?? "")
            .Where(source => source.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        var links = document.Links ?? [];
        if (sources <= 1 || links.Count == 0)
            return null;

        var names = new HashSet<string>(
            (document.Sources ?? []).Select(source => source?.Trim() ?? "").Where(source => source.Length > 0),
            StringComparer.OrdinalIgnoreCase);
        foreach (var link in links)
        {
            if (link.Kind is not ("foreign-key" or "accepted")
                || string.IsNullOrWhiteSpace(link.FromColumn)
                || string.IsNullOrWhiteSpace(link.ToColumn)
                || !names.Contains(link.From ?? "")
                || !names.Contains(link.To ?? ""))
                return null;
        }

        var kinds = new string[links.Count];
        for (var index = 0; index < links.Count; index++)
        {
            if (links[index].ViewOnly)
            {
                if (string.IsNullOrWhiteSpace(links[index].Reason))
                    return new ErrorDto { Code = "link_reason_required", Message = "僅此檢視的關聯要寫理由。" };
                kinds[index] = "accepted";
                continue;
            }

            var origin = DeclaredOrigin(links[index].From, links[index].FromColumn, links[index].To, links[index].ToColumn);
            if (origin is null)
                return new ErrorDto { Code = "link_undeclared", Message = "這段關聯不在註記包裡。" };
            links[index].ViewOnly = false;
            kinds[index] = origin == "foreign-key" ? "foreign-key" : "accepted";
        }

        for (var index = 0; index < links.Count; index++)
            links[index].Kind = kinds[index];
        return null;
    }

    private static void RestoreKinds(IList<ViewLinkDto>? links, string[] kinds)
    {
        if (links is null)
            return;
        for (var index = 0; index < links.Count && index < kinds.Length; index++)
            links[index].Kind = kinds[index];
    }

    private string? DeclaredOrigin(string? from, string? fromColumn, string? to, string? toColumn)
    {
        var left = from?.Trim() ?? "";
        var leftColumn = fromColumn?.Trim() ?? "";
        var right = to?.Trim() ?? "";
        var rightColumn = toColumn?.Trim() ?? "";
        foreach (var link in _eligible)
        {
            var origin = link.Origin?.Trim() ?? "";
            if (origin is not ("foreign-key" or "declared"))
                continue;
            if (SameDeclared(link.From, link.FromColumn, link.To, link.ToColumn, left, leftColumn, right, rightColumn))
                return origin;
        }

        return null;
    }

    private static bool SameDeclared(
        string? from,
        string? fromColumn,
        string? to,
        string? toColumn,
        string otherFrom,
        string otherFromColumn,
        string otherTo,
        string otherToColumn)
    {
        var left = from?.Trim() ?? "";
        var leftColumn = fromColumn?.Trim() ?? "";
        var right = to?.Trim() ?? "";
        var rightColumn = toColumn?.Trim() ?? "";
        var straight = string.Equals(left, otherFrom, StringComparison.Ordinal)
            && string.Equals(leftColumn, otherFromColumn, StringComparison.Ordinal)
            && string.Equals(right, otherTo, StringComparison.Ordinal)
            && string.Equals(rightColumn, otherToColumn, StringComparison.Ordinal);
        var swapped = string.Equals(left, otherTo, StringComparison.Ordinal)
            && string.Equals(leftColumn, otherToColumn, StringComparison.Ordinal)
            && string.Equals(right, otherFrom, StringComparison.Ordinal)
            && string.Equals(rightColumn, otherFromColumn, StringComparison.Ordinal);
        return straight || swapped;
    }

    private static bool SameLink(ViewLinkDto link, SchemaNeighborhood.Suggestion suggestion)
        => string.Equals(link.From, suggestion.From, StringComparison.OrdinalIgnoreCase)
           && string.Equals(link.FromColumn, suggestion.FromColumn, StringComparison.OrdinalIgnoreCase)
           && string.Equals(link.To, suggestion.To, StringComparison.OrdinalIgnoreCase)
           && string.Equals(link.ToColumn, suggestion.ToColumn, StringComparison.OrdinalIgnoreCase);

    private static bool Checked(ChangeEventArgs args) => args.Value is bool value && value;

    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? "";

    private async Task Reload(string operatorId)
    {
        var listed = await ViewEditor.ListAsync(operatorId, CancellationToken.None);
        if (!listed.Ok)
        {
            _error = listed.Error;
            return;
        }

        var documents = new List<ViewDocumentDto>();
        foreach (var summary in listed.Value!)
        {
            var read = await ViewEditor.ReadAsync(operatorId, summary.Id, CancellationToken.None);
            if (read.Ok && read.Value is not null)
                documents.Add(read.Value);
        }

        _documents = documents;
    }

    private void Project(AnnotationActiveDto? active)
    {
        _tableNotes.Clear();
        _columnNotes.Clear();
        _declared = [];
        _eligible = [];
        var package = active?.Package;
        _package = package;
        if (package is not { Active: true } || string.Equals(package.Status, "draft", StringComparison.Ordinal))
        {
            _package = null;
            _tables = [];
            return;
        }

        var included = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var tables = new List<SchemaTableDto>();
        foreach (var table in package.Tables ?? [])
        {
            var name = table.Name?.Trim() ?? "";
            if (name.Length == 0 || !included.Add(name))
                continue;
            if (!string.IsNullOrWhiteSpace(table.Note))
                _tableNotes[name] = table.Note.Trim();

            var columns = new List<SchemaColumnDto>();
            foreach (var column in table.Columns ?? [])
            {
                var columnName = column.Name?.Trim() ?? "";
                if (columnName.Length == 0)
                    continue;
                _columnNotes[NoteKey(name, columnName)] = column.Note?.Trim() ?? "";
                columns.Add(new SchemaColumnDto
                {
                    Name = columnName,
                    Type = column.Type?.Trim() ?? "",
                    PrimaryKey = column.PrimaryKey,
                });
            }

            tables.Add(new SchemaTableDto { Name = name, Columns = columns });
        }

        foreach (var link in package.Links ?? [])
        {
            if (!Eligible(link))
                continue;
            var copy = new AnnotationLinkDto
            {
                From = link.From.Trim(),
                FromColumn = link.FromColumn.Trim(),
                To = link.To.Trim(),
                ToColumn = link.ToColumn.Trim(),
                Origin = link.Origin,
            };
            _eligible.Add(copy);
            if (Declared(link, included))
                _declared.Add(copy);
        }

        foreach (var table in tables)
        {
            foreach (var column in table.Columns)
            {
                var first = _declared.FirstOrDefault(link =>
                    string.Equals(link.From, table.Name, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(link.FromColumn, column.Name, StringComparison.OrdinalIgnoreCase));
                if (first is null)
                    continue;
                column.ReferencesTable = first.To;
                column.ReferencesColumn = first.ToColumn;
            }
        }

        _tables = tables;
    }

    private static bool Eligible(AnnotationLinkDto link)
    {
        if (!string.Equals(link.Origin?.Trim(), "foreign-key", StringComparison.Ordinal)
            && !string.Equals(link.Origin?.Trim(), "declared", StringComparison.Ordinal))
            return false;
        var from = link.From?.Trim() ?? "";
        var to = link.To?.Trim() ?? "";
        var fromColumn = link.FromColumn?.Trim() ?? "";
        var toColumn = link.ToColumn?.Trim() ?? "";
        return from.Length > 0 && to.Length > 0 && fromColumn.Length > 0 && toColumn.Length > 0;
    }

    private static bool Declared(AnnotationLinkDto link, HashSet<string> tables)
    {
        if (!string.Equals(link.Origin, "foreign-key", StringComparison.Ordinal)
            && !string.Equals(link.Origin, "declared", StringComparison.Ordinal))
            return false;
        var from = link.From?.Trim() ?? "";
        var to = link.To?.Trim() ?? "";
        var fromColumn = link.FromColumn?.Trim() ?? "";
        var toColumn = link.ToColumn?.Trim() ?? "";
        return from.Length > 0 && to.Length > 0 && fromColumn.Length > 0 && toColumn.Length > 0
            && tables.Contains(from) && tables.Contains(to);
    }

    private List<SchemaTableDto> WithHiddenEdges(IReadOnlyList<SchemaTableDto> tables)
    {
        var copy = tables.Select(table => new SchemaTableDto
        {
            Name = table.Name,
            Columns = (table.Columns ?? []).Select(column => new SchemaColumnDto
            {
                Name = column.Name,
                Type = column.Type,
                PrimaryKey = column.PrimaryKey,
                ReferencesTable = column.ReferencesTable,
                ReferencesColumn = column.ReferencesColumn,
            }).ToList(),
        }).ToList();

        foreach (var link in _declared)
        {
            var table = copy.FirstOrDefault(item => string.Equals(item.Name, link.From, StringComparison.OrdinalIgnoreCase));
            if (table is null)
                continue;
            var shown = table.Columns.Any(column =>
                string.Equals(column.Name, link.FromColumn, StringComparison.OrdinalIgnoreCase)
                && string.Equals(column.ReferencesTable, link.To, StringComparison.OrdinalIgnoreCase)
                && string.Equals(column.ReferencesColumn, link.ToColumn, StringComparison.OrdinalIgnoreCase));
            if (shown)
                continue;
            table.Columns.Add(new SchemaColumnDto
            {
                Name = link.FromColumn,
                ReferencesTable = link.To,
                ReferencesColumn = link.ToColumn,
            });
        }

        return copy;
    }

    private string? TableNote(string table)
        => _tableNotes.TryGetValue(table, out var note) && !string.IsNullOrWhiteSpace(note) ? note : null;

    private bool ColumnUnmarked(string table, string column)
        => !_columnNotes.TryGetValue(NoteKey(table, column), out var note) || string.IsNullOrWhiteSpace(note);

    private string ColumnNote(string table, string column)
        => _columnNotes.TryGetValue(NoteKey(table, column), out var note) ? note : "";

    private static string NoteKey(string table, string column) => table + "\u001f" + column;

    public void Dispose() => CancelPreview();
}
