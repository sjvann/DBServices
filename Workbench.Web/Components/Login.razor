@page "/"
@inject SessionService Sessions
@inject CircuitSession Session
@inject IJSRuntime Js
@inject NavigationManager Nav
@layout WorkbenchLayout

<form class="panel" @onsubmit="Submit" @onsubmit:preventDefault="true">
    <h1>登入</h1>
    <p class="meta">以操作者名稱與秘密取得工作階段。</p>
    @if (_error is not null)
    {
        <div class="error" role="alert">
            <span class="code">@_error.Code</span>
            <span>@_error.Message</span>
        </div>
    }
    <label for="operator-name">名稱
        <input id="operator-name" autocomplete="username" @bind="_name" @bind:event="oninput" />
    </label>
    <label for="operator-secret">秘密
        <input id="operator-secret" type="password" autocomplete="current-password" @bind="_secret" @bind:event="oninput" />
    </label>
    <div class="actions">
        <button class="secondary" type="submit">登入</button>
    </div>
</form>

@code {
    private string _name = "";
    private string _secret = "";
    private ErrorDto? _error;

    private async Task Submit()
    {
        var result = Sessions.Login(_name, _secret);
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        Session.Adopt(result.Value!.SessionId);
        await Js.InvokeVoidAsync("wbSetSession", result.Value.SessionId);
        Nav.NavigateTo("/live", forceLoad: true);
    }
}
