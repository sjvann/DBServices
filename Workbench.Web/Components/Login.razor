@page "/"
@layout WorkbenchLayout

<form class="panel" method="post" action="/login" data-enhance="false">
    <h1>登入</h1>
    <p class="meta">用名稱和密碼進入工作台。</p>
    @if (_error is not null)
    {
        <div class="error" role="alert">
            <span class="code">@_error.Code</span>
            <span>@_error.Message</span>
        </div>
    }
    <label for="operator-name">名稱
        <input id="operator-name" name="displayName" autocomplete="username" />
    </label>
    <label for="operator-secret">密碼
        <input id="operator-secret" name="secret" type="password" autocomplete="current-password" />
    </label>
    <div class="actions">
        <button class="confirm" type="submit">登入</button>
    </div>
</form>

@code {
    private ErrorDto? _error;

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    protected override void OnParametersSet()
    {
        _error = ErrorCode switch
        {
            "workbench_unavailable" => WorkbenchMessages.Unavailable(),
            "unauthenticated" => WorkbenchMessages.Unauthenticated(),
            _ => null,
        };
    }
}
