{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "DBService/DBServices.csproj",
            "DbServices.Core/DbServices.Core.csproj",
            "DbServices.Provider.Sqlite/DbServices.Provider.Sqlite.csproj",
            "DbServices.Provider.MsSql/DbServices.Provider.MsSql.csproj",
            "DbServices.Provider.MySql/DbServices.Provider.MySql.csproj",
            "DbServices.Provider.Oracle/DbServices.Provider.Oracle.csproj",
            "DbServices.Provider.PostgreSQL/DbServices.Provider.PostgreSQL.csproj",
            "DbServices.Api.Shared/DbServices.Api.Shared.csproj",
            "DbServices.Mcp/DbServices.Mcp.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "api/.manifest",
          "filterConfig.yml"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "DBServices",
      "_appTitle": "DBServices",
      "_appFooter": "<span>Copyright © 2026 sjvann · MIT License</span>",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/sjvann/DBServices",
        "branch": "master"
      }
    },
    "sitemap": {
      "baseUrl": "https://sjvann.github.io/DBServices",
      "priority": 0.5,
      "changefreq": "weekly"
    },
    "markdownEngineName": "markdig",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
